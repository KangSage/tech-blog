---
import { SITE, absoluteUrl, href, withBase, localeHome, localeLabels, localeNames, tagsPath, type Locale } from "@/lib/i18n";
import { t } from "@/lib/ui";

type Alternate = {
  locale: Locale;
  path: string;
};

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath: string;
  alternates?: Alternate[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  locale,
  canonicalPath,
  alternates = [],
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
// 현재 위치에 맞춰 헤더 메뉴를 표시한다: 태그 페이지는 '태그', 나머지 글 관련 페이지는 '글 목록'
const path = Astro.url.pathname;
const currentNav = path.includes("/tags/") ? "tags" : path.includes("/security/") ? "" : "posts";
const canonical = absoluteUrl(canonicalPath);

// 색 토큰은 여기 한 곳에서 정한다. 다크 값은 '시스템이 다크이고 라이트를 고르지 않음'과 '다크를 고름' 두 경우에 같은 값으로 쓰인다
const light = {
  "color-scheme": "light",
  "--bg": "#fafafa", "--surface": "#ffffff", "--text": "#202124", "--muted": "#5f6368", "--border": "#dadce0",
  "--accent": "#146c94", "--accent-soft": "#e5f4fa", "--warning": "#8a5a00",
  "--code-bg": "#111827", "--code-fg": "#f9fafb", "--notice-border": "#e8d18c", "--notice-bg": "#fff8df",
};
const dark = {
  "color-scheme": "dark",
  "--bg": "#121417", "--surface": "#1b1f24", "--text": "#e6e8eb", "--muted": "#a3abb5", "--border": "#363c45",
  "--accent": "#5cb8e4", "--accent-soft": "#173444", "--warning": "#e3b341",
  "--code-bg": "#0b0d10", "--code-fg": "#e6e8eb", "--notice-border": "#6b5a1f", "--notice-bg": "#262110",
};
const decl = (tokens: Record<string, string>) => Object.entries(tokens).map(([k, v]) => `${k}: ${v};`).join(" ");
const themeCss = `:root { ${decl(light)} }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { ${decl(dark)} } }
:root[data-theme="dark"] { ${decl(dark)} }`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <!-- 저장된 테마를 그리기 전에 적용해 깜빡임을 막는다 -->
    <script is:inline>try { const t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch {}</script>
    <style is:inline set:html={themeCss}></style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={localeNames[alternate.locale]}
        href={absoluteUrl(alternate.path)}
      />
    ))}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates[0].path)} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).pathname : import.meta.env.BASE_URL}>
        {SITE.name}
      </a>
      <nav aria-label="Primary navigation" class="main-nav">
        <a href={href(localeHome(locale))} aria-current={currentNav === "posts" ? "page" : undefined}>{t("navPosts", locale)}</a>
        <a href={href(tagsPath(locale))} aria-current={currentNav === "tags" ? "page" : undefined}>{t("navTags", locale)}</a>
      </nav>
      {alternates.length > 1 && <nav aria-label="Languages" class="language-nav">
        {alternates.map((alternate) => (
          <a href={import.meta.env.BASE_URL.replace(/\/$/, "") + alternate.path} aria-current={alternate.locale === locale ? "page" : undefined}>
            {localeLabels[alternate.locale]}
          </a>
        ))}
      </nav>}
      <button type="button" class="theme-toggle" data-label-dark={t("themeToDark", locale)} data-label-light={t("themeToLight", locale)} hidden>
        <svg class="i-moon" viewBox="0 0 20 20" aria-hidden="true"><path d="M15.5 12.6A6.5 6.5 0 0 1 7.4 4.5a6.5 6.5 0 1 0 8.1 8.1z"></path></svg>
        <svg class="i-sun" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.6"></circle><path d="M10 1.5v2.4M10 16.1v2.4M1.5 10h2.4M16.1 10h2.4M4 4l1.7 1.7M14.3 14.3 16 16M4 16l1.7-1.7M14.3 5.7 16 4"></path></svg>
      </button>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {SITE.name}</p>
      <nav aria-label="Site links" class="footer-nav">
        <a href={href(`/${locale}/rss.xml`)}>RSS</a>
        <a href={href("/ko/security/")}>{t("security", locale)}</a>
      </nav>
    </footer>
    <script>
      // 테마 토글: 기본은 시스템 설정을 따르고, 누르면 반대 모드를 이 브라우저에 기억한다.
      // 고른 모드가 시스템 설정과 같아지면 기억을 지워 다시 시스템을 따른다
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      if (toggle) {
        const root = document.documentElement;
        const media = matchMedia("(prefers-color-scheme: dark)");
        const system = () => (media.matches ? "dark" : "light");
        const current = () => root.dataset.theme ?? system();
        const update = () => {
          const label = current() === "dark" ? toggle.dataset.labelLight! : toggle.dataset.labelDark!;
          toggle.setAttribute("aria-label", label);
          toggle.title = label;
          toggle.dataset.mode = current();
        };
        toggle.addEventListener("click", () => {
          const next = current() === "dark" ? "light" : "dark";
          try {
            if (next === system()) { delete root.dataset.theme; localStorage.removeItem("theme"); }
            else { root.dataset.theme = next; localStorage.setItem("theme", next); }
          } catch { root.dataset.theme = next; }
          update();
        });
        media.addEventListener("change", update);
        update();
        toggle.hidden = false;
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    line-height: 1.65;
  }

  a {
    color: var(--accent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .site-header,
  .site-footer,
  main {
    width: min(var(--site-width, 960px), calc(100% - 32px));
    margin: 0 auto;
  }

  /* 사이드 패널이 있는 글: 넓은 화면에서 본문 760px + 패널 360px 폭으로 확장 */
  @media (min-width: 1180px) {
    :root:has(.post-aside:not([hidden])) {
      --site-width: 1148px;
    }

    /* 목차가 있고 패널이 없는 글: 목차 220px + 본문 760px */
    :root:has(.post-toc):not(:has(.post-aside:not([hidden]))) {
      --site-width: 1008px;
    }

    /* 블로그 메인: 찾기 사이드바 260px + 글 목록 760px */
    :root:has(.home-grid) {
      --site-width: 1052px;
    }
  }

  /* 아주 넓은 화면에서 목차와 패널이 함께 있는 글: 220 + 760 + 360px */
  @media (min-width: 1440px) {
    :root:has(.post-toc):has(.post-aside:not([hidden])) {
      --site-width: 1396px;
    }
  }

  .site-header {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px 0 18px;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .language-nav {
    margin-left: auto;
  }

  /* 테마 토글: 헤더 오른쪽 끝. 언어 메뉴가 있으면 그 뒤에 붙는다 */
  .theme-toggle {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    /* 헤더 글줄보다 높은 만큼 위아래를 당겨 헤더 높이를 바꾸지 않는다 */
    margin-block: -5px;
    margin-left: auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }

  .language-nav + .theme-toggle {
    margin-left: 0;
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle svg {
    width: 18px;
    height: 18px;
  }

  .theme-toggle .i-moon {
    fill: currentColor;
  }

  .theme-toggle .i-sun {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* 지금이 다크면 해 아이콘(라이트로), 라이트면 달 아이콘(다크로) */
  .theme-toggle[data-mode="dark"] .i-moon,
  .theme-toggle:not([data-mode="dark"]) .i-sun {
    display: none;
  }

  .main-nav a,
  .language-nav a,
  .footer-nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .main-nav a:hover,
  .language-nav a:hover,
  .footer-nav a:hover {
    color: var(--accent);
  }

  .main-nav a[aria-current],
  .language-nav a[aria-current] {
    color: var(--text);
    font-weight: 600;
  }

  main {
    padding: 40px 0 56px;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 20px;
    padding: 24px 0 36px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.92rem;
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
  }

  h1 {
    max-width: 820px;
    margin: 0 0 16px;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  h2 {
    margin-top: 40px;
  }

  p {
    max-width: 760px;
  }

  code {
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.28em;
    background: var(--surface);
  }

  pre {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    background: var(--code-bg);
    color: var(--code-fg);
  }

  pre code {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
  }

  article table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 16px 0;
    font-size: 0.95rem;
  }

  article th,
  article td {
    border: 1px solid var(--border);
    padding: 8px 12px;
    vertical-align: top;
    /* 한글은 글자마다 줄을 바꿀 수 있어 좁은 화면에서 열이 한 글자 폭까지 줄어든다. 단어 단위로만 바꿔 열이 단어 폭은 유지하게 하고, 넘치면 표가 가로로 스크롤된다 */
    word-break: keep-all;
  }

  article th {
    background: var(--accent-soft);
    text-align: left;
  }

  /* 셀은 단어 단위로 줄을 바꾸지만 링크·코드처럼 띄어쓰기 없이 긴 문자열은 어디서든 끊어 표가 지나치게 넓어지지 않게 한다 */
  article :is(th, td) :is(a, code) {
    overflow-wrap: anywhere;
  }

  /* 화면보다 넓은 표 위의 안내 (글 페이지 스크립트가 넘칠 때만 보인다) */
  .table-scroll-hint {
    margin: 16px 0 -10px;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .table-scroll-hint[hidden] {
    display: none;
  }

  /* 접었다 펴는 글 안의 곁다리 설명 (예: 이 글을 쓰게 된 이유) */
  article details {
    max-width: 760px;
    margin: 0 0 24px;
    padding: 10px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  article summary {
    cursor: pointer;
    color: var(--muted);
    font-weight: 600;
  }

  article summary:hover {
    color: var(--accent);
  }

  article details[open] summary {
    margin-bottom: 8px;
    color: var(--text);
  }

  article details > p:last-child {
    margin-bottom: 4px;
  }

  /* 마지막 열이 짧은 표: 넓은 화면에서는 마지막 열을 줄바꿈하지 않고 남은 폭을 앞 열이 나눠 쓴다 */
  @media (min-width: 720px) {
    .nowrap-last-col th:last-child,
    .nowrap-last-col td:last-child {
      white-space: nowrap;
    }
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .meta {
    color: var(--muted);
    font-size: 0.95rem;
  }

  [hidden] {
    display: none !important;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* 페이지 머리: 제목과 한 줄 소개 */
  .page-intro {
    max-width: 760px;
    margin-bottom: 28px;
  }

  .page-intro h1 {
    margin-bottom: 8px;
    font-size: clamp(1.6rem, 3.5vw, 2.1rem);
  }

  .page-intro p {
    margin: 0;
    color: var(--muted);
  }

  .page-intro .eyebrow {
    margin-bottom: 6px;
  }

  /* 칩: 카테고리·태그 필터와 태그 목록 */
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.9rem;
    text-decoration: none;
  }

  a.chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .chip[aria-current] {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }

  .chip.is-empty {
    color: var(--muted);
    opacity: 0.55;
  }

  .chip-count {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 400;
  }

  .tag-chip {
    font-size: 0.85rem;
  }

  /* 메인 검색 */
  .finder {
    max-width: 760px;
    margin-bottom: 8px;
  }

  .finder-search {
    display: block;
    margin-bottom: 14px;
  }

  .finder-search input {
    box-sizing: border-box;
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }

  .finder-search input:focus {
    outline: 2px solid var(--accent-soft);
    border-color: var(--accent);
  }

  .finder-status {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .finder-clear {
    border: 0;
    padding: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
  }

  /* 글 목록: 줄마다 날짜·카테고리 / 제목 / 설명 / 태그 */
  .post-rows {
    max-width: 760px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .post-row {
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }

  .post-row-meta {
    display: flex;
    gap: 10px;
    margin: 0 0 4px;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .post-row-meta a {
    color: var(--muted);
    text-decoration: none;
  }

  .post-row-meta a:hover {
    color: var(--accent);
  }

  .post-row-title {
    margin: 0 0 6px;
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .post-row-title a {
    color: var(--text);
    text-decoration: none;
  }

  .post-row-title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .post-row-desc {
    margin: 0 0 8px;
    color: var(--muted);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
  }

  .tag {
    color: var(--accent);
    text-decoration: none;
  }

  .tag:hover {
    text-decoration: underline;
  }

  .no-results {
    color: var(--muted);
  }

  .post-head .tag-list {
    margin-top: -4px;
  }

  .post-head .eyebrow a {
    color: var(--accent);
    text-decoration: none;
  }

  .security-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin: 28px 0;
  }

  .stat {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    background: var(--surface);
  }

  .stat strong {
    display: block;
    font-size: 1.8rem;
    line-height: 1.1;
  }

  .notice {
    border: 1px solid var(--notice-border);
    border-radius: 8px;
    padding: 16px;
    background: var(--notice-bg);
    color: var(--warning);
  }

  @media (max-width: 720px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .language-nav {
      margin-left: 0;
    }

    /* 좁은 화면은 헤더가 세로로 쌓이므로 토글을 오른쪽 위에 띄워 줄을 늘리지 않는다 */
    .site-header {
      position: relative;
    }

    .theme-toggle {
      position: absolute;
      top: 16px;
      right: 0;
      margin-block: 0;
    }
  }
</style>
