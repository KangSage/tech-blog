---
import { SITE, absoluteUrl, href, localeHome, localeLabels, localeNames, tagsPath, type Locale } from "@/lib/i18n";
import { t } from "@/lib/ui";

type Alternate = {
  locale: Locale;
  path: string;
};

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath: string;
  alternates?: Alternate[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  locale,
  canonicalPath,
  alternates = [],
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
// 현재 위치에 맞춰 헤더 메뉴를 표시한다: 태그 페이지는 '태그', 나머지 글 관련 페이지는 '글 목록'
const path = Astro.url.pathname;
const currentNav = path.includes("/tags/") ? "tags" : path.includes("/security/") ? "" : "posts";
const canonical = absoluteUrl(canonicalPath);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={localeNames[alternate.locale]}
        href={absoluteUrl(alternate.path)}
      />
    ))}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates[0].path)} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).pathname : import.meta.env.BASE_URL}>
        {SITE.name}
      </a>
      <nav aria-label="Primary navigation" class="main-nav">
        <a href={href(localeHome(locale))} aria-current={currentNav === "posts" ? "page" : undefined}>{t("navPosts", locale)}</a>
        <a href={href(tagsPath(locale))} aria-current={currentNav === "tags" ? "page" : undefined}>{t("navTags", locale)}</a>
      </nav>
      {alternates.length > 1 && <nav aria-label="Languages" class="language-nav">
        {alternates.map((alternate) => (
          <a href={import.meta.env.BASE_URL.replace(/\/$/, "") + alternate.path} aria-current={alternate.locale === locale ? "page" : undefined}>
            {localeLabels[alternate.locale]}
          </a>
        ))}
      </nav>}
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {SITE.name}</p>
      <nav aria-label="Site links" class="footer-nav">
        <a href={href(`/${locale}/rss.xml`)}>RSS</a>
        <a href={href("/ko/security/")}>{t("security", locale)}</a>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #fafafa;
    --surface: #ffffff;
    --text: #202124;
    --muted: #5f6368;
    --border: #dadce0;
    --accent: #146c94;
    --accent-soft: #e5f4fa;
    --warning: #8a5a00;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    line-height: 1.65;
  }

  a {
    color: var(--accent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .site-header,
  .site-footer,
  main {
    width: min(var(--site-width, 960px), calc(100% - 32px));
    margin: 0 auto;
  }

  /* 사이드 패널이 있는 글: 넓은 화면에서 본문 760px + 패널 360px 폭으로 확장 */
  @media (min-width: 1180px) {
    :root:has(.post-aside:not([hidden])) {
      --site-width: 1148px;
    }
  }

  .site-header {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px 0 18px;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .language-nav {
    margin-left: auto;
  }

  .main-nav a,
  .language-nav a,
  .footer-nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .main-nav a:hover,
  .language-nav a:hover,
  .footer-nav a:hover {
    color: var(--accent);
  }

  .main-nav a[aria-current],
  .language-nav a[aria-current] {
    color: var(--text);
    font-weight: 600;
  }

  main {
    padding: 40px 0 56px;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 20px;
    padding: 24px 0 36px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.92rem;
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
  }

  h1 {
    max-width: 820px;
    margin: 0 0 16px;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  h2 {
    margin-top: 40px;
  }

  p {
    max-width: 760px;
  }

  code {
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.28em;
    background: var(--surface);
  }

  pre {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    background: #111827;
    color: #f9fafb;
  }

  pre code {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
  }

  article table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 16px 0;
    font-size: 0.95rem;
  }

  article th,
  article td {
    border: 1px solid var(--border);
    padding: 8px 12px;
    vertical-align: top;
  }

  article th {
    background: var(--accent-soft);
    text-align: left;
  }

  /* 마지막 열이 짧은 표: 넓은 화면에서는 마지막 열을 줄바꿈하지 않고 남은 폭을 앞 열이 나눠 쓴다 */
  @media (min-width: 720px) {
    .nowrap-last-col th:last-child,
    .nowrap-last-col td:last-child {
      white-space: nowrap;
    }
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .meta {
    color: var(--muted);
    font-size: 0.95rem;
  }

  [hidden] {
    display: none !important;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* 페이지 머리: 제목과 한 줄 소개 */
  .page-intro {
    max-width: 760px;
    margin-bottom: 28px;
  }

  .page-intro h1 {
    margin-bottom: 8px;
    font-size: clamp(1.6rem, 3.5vw, 2.1rem);
  }

  .page-intro p {
    margin: 0;
    color: var(--muted);
  }

  .page-intro .eyebrow {
    margin-bottom: 6px;
  }

  /* 칩: 카테고리·태그 필터와 태그 목록 */
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.9rem;
    text-decoration: none;
  }

  a.chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .chip[aria-current] {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }

  .chip.is-empty {
    color: var(--muted);
    opacity: 0.55;
  }

  .chip-count {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 400;
  }

  .tag-chip {
    font-size: 0.85rem;
  }

  /* 메인 검색 */
  .finder {
    max-width: 760px;
    margin-bottom: 8px;
  }

  .finder-search {
    display: block;
    margin-bottom: 14px;
  }

  .finder-search input {
    box-sizing: border-box;
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }

  .finder-search input:focus {
    outline: 2px solid var(--accent-soft);
    border-color: var(--accent);
  }

  .finder-status {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .finder-clear {
    border: 0;
    padding: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
  }

  /* 글 목록: 줄마다 날짜·카테고리 / 제목 / 설명 / 태그 */
  .post-rows {
    max-width: 760px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .post-row {
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }

  .post-row-meta {
    display: flex;
    gap: 10px;
    margin: 0 0 4px;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .post-row-meta a {
    color: var(--muted);
    text-decoration: none;
  }

  .post-row-meta a:hover {
    color: var(--accent);
  }

  .post-row-title {
    margin: 0 0 6px;
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .post-row-title a {
    color: var(--text);
    text-decoration: none;
  }

  .post-row-title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .post-row-desc {
    margin: 0 0 8px;
    color: var(--muted);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
  }

  .tag {
    color: var(--accent);
    text-decoration: none;
  }

  .tag:hover {
    text-decoration: underline;
  }

  .no-results {
    color: var(--muted);
  }

  .post-head .tag-list {
    margin-top: -4px;
  }

  .post-head .eyebrow a {
    color: var(--accent);
    text-decoration: none;
  }

  .security-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin: 28px 0;
  }

  .stat {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    background: var(--surface);
  }

  .stat strong {
    display: block;
    font-size: 1.8rem;
    line-height: 1.1;
  }

  .notice {
    border: 1px solid #e8d18c;
    border-radius: 8px;
    padding: 16px;
    background: #fff8df;
    color: var(--warning);
  }

  @media (max-width: 720px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .language-nav {
      margin-left: 0;
    }
  }
</style>
