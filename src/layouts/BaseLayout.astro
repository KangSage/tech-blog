---
import { SITE, absoluteUrl, localeLabels, localeNames, type Locale } from "@/lib/i18n";

type Alternate = {
  locale: Locale;
  path: string;
};

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath: string;
  alternates?: Alternate[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  locale,
  canonicalPath,
  alternates = [],
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const canonical = absoluteUrl(canonicalPath);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={localeNames[alternate.locale]}
        href={absoluteUrl(alternate.path)}
      />
    ))}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates[0].path)} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).pathname : import.meta.env.BASE_URL}>
        {SITE.name}
      </a>
      <nav aria-label="Primary navigation">
        <a href={import.meta.env.BASE_URL + "ko/"}>Garden</a>
        <a href={import.meta.env.BASE_URL + "ko/security/"}>Security</a>
      </nav>
      <nav aria-label="Languages" class="language-nav">
        {alternates.map((alternate) => (
          <a href={import.meta.env.BASE_URL.replace(/\/$/, "") + alternate.path} aria-current={alternate.locale === locale ? "page" : undefined}>
            {localeLabels[alternate.locale]}
          </a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {SITE.name}. A static garden with dependency advisory monitoring.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #fafafa;
    --surface: #ffffff;
    --text: #202124;
    --muted: #5f6368;
    --border: #dadce0;
    --accent: #146c94;
    --accent-soft: #e5f4fa;
    --warning: #8a5a00;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    line-height: 1.65;
  }

  a {
    color: var(--accent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .site-header,
  .site-footer,
  main {
    width: min(960px, calc(100% - 32px));
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px 0 18px;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .language-nav {
    margin-left: auto;
  }

  main {
    padding: 40px 0 56px;
  }

  .site-footer {
    padding: 24px 0 36px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.92rem;
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
  }

  h1 {
    max-width: 820px;
    margin: 0 0 16px;
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  h2 {
    margin-top: 40px;
  }

  p {
    max-width: 760px;
  }

  code {
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.28em;
    background: var(--surface);
  }

  pre {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    background: #111827;
    color: #f9fafb;
  }

  pre code {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .meta {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .post-list {
    display: grid;
    gap: 18px;
    padding: 0;
    list-style: none;
  }

  .post-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    background: var(--surface);
  }

  .post-card h2 {
    margin: 0 0 8px;
    font-size: 1.35rem;
  }

  .post-card h3 {
    margin: 0 0 8px;
    font-size: 1.2rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    margin: 32px 0 40px;
  }

  .category-card {
    display: grid;
    gap: 8px;
    min-height: 124px;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 18px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .category-card span {
    font-weight: 700;
  }

  .category-card small {
    color: var(--muted);
    line-height: 1.5;
  }

  .category-section {
    margin-top: 36px;
  }

  .security-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin: 28px 0;
  }

  .stat {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    background: var(--surface);
  }

  .stat strong {
    display: block;
    font-size: 1.8rem;
    line-height: 1.1;
  }

  .notice {
    border: 1px solid #e8d18c;
    border-radius: 8px;
    padding: 16px;
    background: #fff8df;
    color: var(--warning);
  }

  @media (max-width: 720px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .language-nav {
      margin-left: 0;
    }
  }
</style>
