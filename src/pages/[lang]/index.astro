---
import PostFinder from "@/components/PostFinder.astro";
import PostList from "@/components/PostList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { assertLocale, localeHome, locales } from "@/lib/i18n";
import { getLocalesWithPosts, getPostsByLocale, getTagCounts } from "@/lib/posts";
import { t } from "@/lib/ui";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = assertLocale(Astro.params.lang);
const posts = await getPostsByLocale(lang);
const tags = await getTagCounts(lang);
const withPosts = await getLocalesWithPosts();
// 언어 전환에는 글이 있는 언어만 보여 준다 (현재 언어는 항상 포함)
const alternates = locales
  .filter((locale) => locale === lang || withPosts.includes(locale))
  .map((locale) => ({ locale, path: localeHome(locale) }));
---

<BaseLayout
  title={t("homeTitle", lang)}
  description={t("homeDescription", lang)}
  locale={lang}
  canonicalPath={localeHome(lang)}
  alternates={alternates}
  noindex={posts.length === 0}
>
  <header class="page-intro">
    <h1>{t("homeTitle", lang)}</h1>
    <p>{t("homeDescription", lang)}</p>
  </header>

  {posts.length === 0 ? (
    <p class="notice">{t("noPosts", lang)}</p>
  ) : (
    <div class="home-grid">
      <aside class="home-aside">
        <PostFinder posts={posts} tags={tags} lang={lang} />
      </aside>
      <div class="home-main">
        <PostList posts={posts} lang={lang} />
        <p class="no-results" data-no-results hidden>{t("noResults", lang)}</p>
      </div>
    </div>
  )}
</BaseLayout>

<style>
  /* 넓은 화면: 왼쪽은 글 찾기(검색·카테고리·태그), 오른쪽은 글 목록. 찾기 열은 화면에 고정 */
  @media (min-width: 1180px) {
    .home-grid {
      display: grid;
      grid-template-columns: 260px 760px;
      gap: 32px;
      align-items: start;
    }

    .home-aside {
      position: sticky;
      top: 16px;
      max-height: calc(100vh - 32px);
      overflow-y: auto;
    }

    .home-main {
      min-width: 0;
    }
  }
</style>
