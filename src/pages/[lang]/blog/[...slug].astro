---
import { render } from "astro:content";
import PostToc from "@/components/PostToc.astro";
import ReadAloud from "@/components/ReadAloud.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryLabels } from "@/lib/categories";
import { absoluteUrl, assertLocale, blogPath, categoryPath, href, tagPath, type Locale } from "@/lib/i18n";
import { formatDate, getAlternates, getPublishedPosts, localeFromId, slugFromId } from "@/lib/posts";
import { t } from "@/lib/ui";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => {
    const lang = localeFromId(post.id);
    return {
      params: { lang, slug: slugFromId(post.id) },
      props: { post },
    };
  });
}

const lang = assertLocale(Astro.params.lang);
const { post } = Astro.props;
const slug = slugFromId(post.id);
const { Content, headings } = await render(post);
const alternates = await getAlternates(post.data.translationKey);
const canonicalPath = blogPath(lang, slug);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  inLanguage: lang,
  url: absoluteUrl(canonicalPath),
  author: {
    "@type": "Person",
    name: "KangSage",
  },
  publisher: {
    "@type": "Organization",
    name: "Sage Garden",
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  locale={lang as Locale}
  canonicalPath={canonicalPath}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <article>
    <header class="post-head">
      <p class="eyebrow">
        <a href={href(categoryPath(lang, post.data.category))}>{categoryLabels[post.data.category][lang]}</a>
      </p>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
        {post.data.updatedAt && <> · {t("updated", lang)} <time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt)}</time></>}
      </p>
      {post.data.tags.length > 0 && (
        <ul class="tag-list">
          {post.data.tags.map((tag) => (
            <li><a class="tag" href={href(tagPath(lang, tag))}>#{tag}</a></li>
          ))}
        </ul>
      )}
      <PostToc headings={headings} lang={lang} variant="inline" />
    </header>
    <div class="post-grid">
      <PostToc headings={headings} lang={lang} variant="column" />
      <!-- 글 속 컴포넌트가 스크립트로 옮겨 넣는 고정 패널 자리. 비어 있으면 숨김 -->
      <aside class="post-aside" id="post-aside" hidden></aside>
      <div class="post-body">
        <Content />
        <ReadAloud lang={lang} />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-head,
  .post-body {
    max-width: 760px;
  }

  .post-head h1 {
    max-width: none;
  }

  .post-body {
    min-width: 0;
  }

  /* 목차로 이동한 제목이 좁은 화면의 고정 패널 아래에 보이게 한다 (--toc-offset은 PostToc가 잰다) */
  .post-body :global(:is(h2, h3)) {
    scroll-margin-top: calc(var(--toc-offset, 0px) + 12px);
  }

  /* 왼쪽 목차 열은 넓은 화면에서만 보인다. 그 밖에는 글 머리 아래의 접힌 목차를 쓴다 */
  .post-grid :global(.post-toc) {
    display: none;
  }

  /* 좁은 화면: 패널이 본문 위에 붙어 스크롤해도 상단에 고정 */
  .post-aside {
    position: sticky;
    top: 0;
    z-index: 10;
    margin: 0 -16px;
    padding: 8px 16px 10px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 6px 12px -10px rgb(0 0 0 / 0.25);
  }

  .post-aside[hidden] {
    display: none;
  }

  /* 넓은 화면: 본문 | 패널 2열, 패널은 오른쪽에 고정 */
  @media (min-width: 1180px) {
    .post-grid:has(.post-aside:not([hidden])) {
      display: grid;
      grid-template-columns: 760px 360px;
      gap: 28px;
      align-items: start;
    }

    .post-aside {
      grid-column: 2;
      grid-row: 1;
      top: 16px;
      margin: 0;
      padding: 0;
      max-height: calc(100vh - 32px);
      overflow-y: auto;
      background: none;
      border: 0;
      box-shadow: none;
    }

    .post-body {
      grid-column: 1;
      grid-row: 1;
    }

    /* 오른쪽 패널이 없는 글: 목차 | 본문 2열 */
    .post-grid:has(:global(.post-toc)):not(:has(.post-aside:not([hidden]))) {
      display: grid;
      grid-template-columns: 220px 760px;
      gap: 28px;
      align-items: start;
    }

    .post-grid:has(:global(.post-toc)):not(:has(.post-aside:not([hidden]))) .post-body {
      grid-column: 2;
    }

    .post-grid:not(:has(.post-aside:not([hidden]))) :global(.post-toc) {
      display: block;
      grid-column: 1;
      grid-row: 1;
    }

    article:has(:global(.post-toc)):not(:has(.post-aside:not([hidden]))) .post-head {
      margin-left: 248px;
    }

    article:has(:global(.post-toc)):not(:has(.post-aside:not([hidden]))) .post-head :global(.toc-inline) {
      display: none;
    }
  }

  /* 아주 넓은 화면에서 패널이 있는 글: 목차 | 본문 | 패널 3열 */
  @media (min-width: 1440px) {
    .post-grid:has(:global(.post-toc)):has(.post-aside:not([hidden])) {
      grid-template-columns: 220px 760px 360px;
    }

    .post-grid:has(:global(.post-toc)):has(.post-aside:not([hidden])) :global(.post-toc) {
      display: block;
      grid-column: 1;
      grid-row: 1;
    }

    .post-grid:has(:global(.post-toc)):has(.post-aside:not([hidden])) .post-body {
      grid-column: 2;
    }

    .post-grid:has(:global(.post-toc)):has(.post-aside:not([hidden])) .post-aside {
      grid-column: 3;
    }

    article:has(:global(.post-toc)):has(.post-aside:not([hidden])) .post-head {
      margin-left: 248px;
    }

    article:has(:global(.post-toc)):has(.post-aside:not([hidden])) .post-head :global(.toc-inline) {
      display: none;
    }
  }

  /* 목차 열: 화면에 고정하고 길면 열 안에서 스크롤 */
  .post-grid :global(.post-toc) {
    position: sticky;
    top: 16px;
    max-height: calc(100vh - 32px);
    overflow-y: auto;
  }
</style>
