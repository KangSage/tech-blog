---
import { render } from "astro:content";
import Comments from "@/components/Comments.astro";
import PostToc from "@/components/PostToc.astro";
import ReadAloud from "@/components/ReadAloud.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryLabels } from "@/lib/categories";
import { absoluteUrl, assertLocale, blogPath, categoryPath, href, tagPath, type Locale } from "@/lib/i18n";
import { formatDate, getAlternates, getPublishedPosts, getUpdatedAt, localeFromId, slugFromId } from "@/lib/posts";
import { t } from "@/lib/ui";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => {
    const lang = localeFromId(post.id);
    return {
      params: { lang, slug: slugFromId(post.id) },
      props: { post },
    };
  });
}

const lang = assertLocale(Astro.params.lang);
const { post } = Astro.props;
const slug = slugFromId(post.id);
const { Content, headings } = await render(post);
const alternates = await getAlternates(post.data.translationKey);
const updatedAt = getUpdatedAt(post);
const canonicalPath = blogPath(lang, slug);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (updatedAt ?? post.data.publishedAt).toISOString(),
  inLanguage: lang,
  url: absoluteUrl(canonicalPath),
  author: {
    "@type": "Person",
    name: "KangSage",
  },
  publisher: {
    "@type": "Organization",
    name: "Sage Garden",
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  locale={lang as Locale}
  canonicalPath={canonicalPath}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <article>
    <header class="post-head">
      <p class="eyebrow">
        <a href={href(categoryPath(lang, post.data.category))}>{categoryLabels[post.data.category][lang]}</a>
      </p>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
        {updatedAt && <> · {t("updated", lang)} <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></>}
      </p>
      {post.data.tags.length > 0 && (
        <ul class="tag-list">
          {post.data.tags.map((tag) => (
            <li><a class="tag" href={href(tagPath(lang, tag))}>#{tag}</a></li>
          ))}
        </ul>
      )}
      <PostToc headings={headings} lang={lang} variant="inline" />
    </header>
    <div class="post-grid">
      <PostToc headings={headings} lang={lang} variant="column" />
      <!-- 글 속 컴포넌트가 스크립트로 옮겨 넣는 고정 패널 자리. 비어 있으면 숨김 -->
      <aside class="post-aside" id="post-aside" hidden></aside>
      <div
        class="post-body"
        data-table-hint={t("tableScrollHint", lang)}
        data-copy-label={t("copyCodeLabel", lang)}
        data-copy-done={t("copyCodeDone", lang)}
        data-copy-failed={t("copyCodeFailed", lang)}
      >
        <Content />
        <ReadAloud lang={lang} />
      </div>
    </div>
    <!-- 댓글은 본문(.post-body) 밖에 두어 읽어 주기가 읽지 않는다 -->
    <Comments lang={lang} />
  </article>
</BaseLayout>

<script>
  // 화면보다 넓어 가로로 스크롤되는 표에만 위쪽에 '좌우로 밀어서 보기' 안내를 붙인다. 안내는 읽어 주기에서 건너뛴다
  const body = document.querySelector<HTMLElement>(".post-body");
  const text = body?.dataset.tableHint;
  if (body && text) {
    const updates: (() => void)[] = [];
    body.querySelectorAll("table").forEach((table) => {
      const hint = document.createElement("p");
      hint.className = "table-scroll-hint";
      hint.dataset.readSkip = "";
      hint.textContent = text;
      table.before(hint);
      const update = () => { hint.hidden = table.scrollWidth <= table.clientWidth + 1; };
      update();
      updates.push(update);
    });
    window.addEventListener("resize", () => updates.forEach((u) => u()));
  }

  // 본문의 모든 코드 블록에 복사 아이콘 버튼을 붙인다. 버튼은 가로 스크롤과 함께 밀리지 않게 pre를 감싼 상자에 두고 읽어 주기에서 건너뛴다.
  // 성공하면 아이콘만 체크로 바뀌고 "복사됨"은 화면 낭독기에만 알린다. 실패하면 아이콘이 그대로이므로 "복사 실패" 말풍선을 보여 준다
  if (body?.dataset.copyLabel) {
    const { copyLabel = "", copyDone = "", copyFailed = "" } = body.dataset;
    const icons =
      '<svg class="icon-copy" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>' +
      '<svg class="icon-done" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
    const writeText = async (text: string) => {
      try {
        if (navigator.clipboard?.writeText) return await navigator.clipboard.writeText(text);
      } catch {
        // 권한이나 포커스 문제로 거부되면 아래 방식으로 한 번 더 시도한다
      }
      // 클립보드 API가 없거나 거부된 환경(보안 연결이 아닌 주소 등)에서는 선택 후 복사로 대신한다
      const area = document.createElement("textarea");
      area.value = text;
      area.setAttribute("readonly", "");
      area.style.position = "fixed";
      area.style.opacity = "0";
      // 선택하려면 포커스가 임시 칸으로 옮겨 가므로 지운 뒤 원래 자리(키보드로 누른 복사 버튼)로 되돌린다
      const focused = document.activeElement;
      document.body.append(area);
      area.select();
      const ok = document.execCommand("copy");
      area.remove();
      if (focused instanceof HTMLElement && focused !== document.body) focused.focus({ preventScroll: true });
      if (!ok) throw new Error("copy failed");
    };
    body.querySelectorAll("pre").forEach((pre) => {
      const box = document.createElement("div");
      box.className = "code-block";
      pre.before(box);
      box.append(pre);
      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-copy";
      button.dataset.readSkip = "";
      button.title = copyLabel;
      button.setAttribute("aria-label", copyLabel);
      button.innerHTML = icons;
      const toast = document.createElement("span");
      toast.className = "sr-only";
      toast.dataset.readSkip = "";
      toast.setAttribute("role", "status");
      let timer = 0;
      button.addEventListener("click", async () => {
        const text = (pre.querySelector("code") ?? pre).textContent ?? "";
        let ok = true;
        try {
          await writeText(text.replace(/\n$/, ""));
        } catch {
          ok = false;
        }
        button.dataset.state = ok ? "done" : "failed";
        toast.className = ok ? "sr-only" : "code-copy-toast";
        toast.textContent = ok ? copyDone : copyFailed;
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          delete button.dataset.state;
          toast.className = "sr-only";
          toast.textContent = "";
        }, 2000);
      });
      box.append(toast, button);
    });
  }
</script>

<style>
  .post-head,
  .post-body {
    max-width: 760px;
  }

  .post-head h1 {
    max-width: none;
  }

  .post-body {
    min-width: 0;
  }

  /* 목차로 이동한 제목이 좁은 화면의 고정 패널 아래에 보이게 한다 (--toc-offset은 PostToc가 잰다) */
  .post-body :global(:is(h2, h3)) {
    scroll-margin-top: calc(var(--toc-offset, 0px) + 12px);
  }

  /* 왼쪽 목차 열은 넓은 화면에서만 보인다. 그 밖에는 글 머리 아래의 접힌 목차를 쓴다 */
  .post-grid :global(.post-toc) {
    display: none;
  }

  /* 좁은 화면: 패널이 본문 위에 붙어 스크롤해도 상단에 고정 */
  .post-aside {
    position: sticky;
    top: 0;
    z-index: 10;
    /* 본문 끝의 읽어 주기 도크(위 여백 32px + 재생 중 조작 바 약 89px)와 겹치지 않게 막대가 그만큼 앞에서 멈춘다. 뒤따르는 지도의 음수 margin-top이 흐름 위치를 되돌린다 */
    margin: 0 -16px 124px;
    padding: 8px 16px 10px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 6px 12px -10px rgb(0 0 0 / 0.25);
  }

  .post-aside[hidden] {
    display: none;
  }

  /* 넓은 화면: 본문 | 패널 2열, 패널은 오른쪽에 고정 */
  @media (min-width: 1180px) {
    .post-grid:has(.post-aside:not([hidden])) {
      display: grid;
      grid-template-columns: 760px 360px;
      gap: 28px;
      align-items: start;
    }

    /* 패널은 안에서 스크롤되므로 가장자리에 붙은 버튼의 포커스 윤곽선이 잘리지 않게 4px 여백을 두고 그만큼 바깥으로 넓힌다(내용 위치와 보이는 높이는 그대로) */
    .post-aside {
      grid-column: 2;
      grid-row: 1;
      top: 12px;
      margin: -4px;
      padding: 4px;
      scroll-padding-block: 4px;
      max-height: calc(100vh - 32px);
      overflow-y: auto;
      background: none;
      border: 0;
      box-shadow: none;
    }

    .post-body {
      grid-column: 1;
      grid-row: 1;
    }

    /* 오른쪽 패널이 없는 글: 목차 | 본문 2열 */
    .post-grid:has(:global(.post-toc)):not(:has(.post-aside:not([hidden]))) {
      display: grid;
      grid-template-columns: 220px 760px;
      gap: 28px;
      align-items: start;
    }

    .post-grid:has(:global(.post-toc)):not(:has(.post-aside:not([hidden]))) .post-body {
      grid-column: 2;
    }

    .post-grid:not(:has(.post-aside:not([hidden]))) :global(.post-toc) {
      display: block;
      grid-column: 1;
      grid-row: 1;
    }

    article:has(:global(.post-toc)):not(:has(.post-aside:not([hidden]))) .post-head,
    article:has(:global(.post-toc)):not(:has(.post-aside:not([hidden]))) > :global(.post-comments) {
      margin-left: 248px;
    }

    article:has(:global(.post-toc)):not(:has(.post-aside:not([hidden]))) .post-head :global(.toc-inline) {
      display: none;
    }
  }

  /* 아주 넓은 화면에서 패널이 있는 글: 목차 | 본문 | 패널 3열 */
  @media (min-width: 1440px) {
    .post-grid:has(:global(.post-toc)):has(.post-aside:not([hidden])) {
      grid-template-columns: 220px 760px 360px;
    }

    .post-grid:has(:global(.post-toc)):has(.post-aside:not([hidden])) :global(.post-toc) {
      display: block;
      grid-column: 1;
      grid-row: 1;
    }

    .post-grid:has(:global(.post-toc)):has(.post-aside:not([hidden])) .post-body {
      grid-column: 2;
    }

    .post-grid:has(:global(.post-toc)):has(.post-aside:not([hidden])) .post-aside {
      grid-column: 3;
    }

    article:has(:global(.post-toc)):has(.post-aside:not([hidden])) .post-head,
    article:has(:global(.post-toc)):has(.post-aside:not([hidden])) > :global(.post-comments) {
      margin-left: 248px;
    }

    article:has(:global(.post-toc)):has(.post-aside:not([hidden])) .post-head :global(.toc-inline) {
      display: none;
    }
  }

  /* 목차 열: 화면에 고정하고 길면 열 안에서 스크롤. 안에서 스크롤되므로 링크의 포커스 링이 잘리지 않게 4px 여백을 두고 그만큼 바깥으로 넓힌다 */
  .post-grid :global(.post-toc) {
    position: sticky;
    top: 12px;
    margin: -4px;
    padding: 4px;
    scroll-padding-block: 4px;
    max-height: calc(100vh - 32px);
    overflow-y: auto;
  }
</style>
