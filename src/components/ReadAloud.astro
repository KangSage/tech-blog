---
// 글 본문 읽어 주기: 브라우저 음성 합성(Web Speech API)만 쓰고 서버·외부 서비스는 쓰지 않는다.
// 본문(.post-body)의 시맨틱 태그를 기준으로 읽을 단위를 정한다: 제목, 문단·목록 항목, 표의 행("열 이름: 값"), 그림(aria-label).
// 사이드바의 개념 카드와 버튼·내비게이션은 읽지 않는다. 읽는 문장은 CSS Custom Highlight로 표시해 DOM을 바꾸지 않는다.
// 본문 끝에 두는 sticky 도크라서 본문을 보는 동안 화면 하단(본문 칼럼 폭 안)에 떠 있고, 글이 끝나면 마지막 문단 뒤에 자리 잡는다.
// 평소에는 오른쪽 아래 작은 시작 버튼, 재생 중에는 조작 바로 펼친다.
import type { Locale } from "@/lib/i18n";
import { t } from "@/lib/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const labels = {
  pause: t("readPause", lang),
  resume: t("readResume", lang),
  noVoice: t("readNoVoice", lang),
  figure: t("readFigure", lang),
};
---

<div class="ra-dock" data-read-aloud data-read-skip data-lang={lang} data-labels={JSON.stringify(labels)} hidden>
  <div class="ra-idle">
    <span class="ra-notice" role="status" aria-live="polite"></span>
    <button type="button" class="ra-start">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 4l10 6-10 6z"></path></svg>
      {t("readAloud", lang)}
    </button>
  </div>
  <div class="ra-bar" hidden>
  <p class="ra-status" role="status" aria-live="polite"></p>
  <div class="ra-controls">
    <button type="button" class="ra-icon ra-prev" aria-label={t("readPrev", lang)} title={t("readPrev", lang)}>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 4h2v12H5zM16 4v12L8 10z"></path></svg>
    </button>
    <button type="button" class="ra-icon ra-toggle" aria-label={labels.pause} title={labels.pause}>
      <svg class="ra-i-pause" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 4h3.5v12H5zM11.5 4H15v12h-3.5z"></path></svg>
      <svg class="ra-i-play" viewBox="0 0 20 20" aria-hidden="true"><path d="M6 4l10 6-10 6z"></path></svg>
    </button>
    <button type="button" class="ra-icon ra-next" aria-label={t("readNext", lang)} title={t("readNext", lang)}>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M13 4h2v12h-2zM4 4v12l8-6z"></path></svg>
    </button>
    <button type="button" class="ra-icon ra-rate" aria-label={t("readRate", lang)} title={t("readRate", lang)}>1×</button>
    <button type="button" class="ra-icon ra-stop" aria-label={t("readStop", lang)} title={t("readStop", lang)}>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5h10v10H5z"></path></svg>
    </button>
  </div>
  </div>
</div>

<script>
  type Item = { text: string; range: Range | null; el: Element; section: number };

  const root = document.querySelector<HTMLElement>("[data-read-aloud]");
  const body = document.querySelector<HTMLElement>(".post-body");
  const synth = "speechSynthesis" in window ? window.speechSynthesis : null;

  if (root && body && synth) {
    const speech: SpeechSynthesis = synth;
    const lang = root.dataset.lang ?? document.documentElement.lang;
    const labels = JSON.parse(root.dataset.labels ?? "{}") as Record<string, string>;
    const start = root.querySelector<HTMLButtonElement>(".ra-start")!;
    const idle = root.querySelector<HTMLElement>(".ra-idle")!;
    const bar = root.querySelector<HTMLElement>(".ra-bar")!;
    const toggle = bar.querySelector<HTMLButtonElement>(".ra-toggle")!;
    const status = bar.querySelector<HTMLElement>(".ra-status")!;
    const notice = root.querySelector<HTMLElement>(".ra-notice")!;
    const highlights = "highlights" in CSS ? CSS.highlights : null;
    root.hidden = false;

    // 기호는 소리로 읽으면 어색하므로 말로 바꾸거나 뺀다
    const spoken: Record<string, [RegExp, string][]> = {
      ko: [[/✓/g, "예"], [/✗/g, "아니요"], [/∩/g, " 교집합 "]],
      ja: [[/✓/g, "はい"], [/✗/g, "いいえ"], [/∩/g, " 積集合 "]],
      en: [[/✓/g, "yes"], [/✗/g, "no"], [/∩/g, " intersect "]],
    };
    const speakable = (text: string) =>
      (spoken[lang] ?? [])
        .reduce((s, [re, word]) => s.replace(re, word), text)
        .replace(/↗/g, "")
        .replace(/\s*(→|·|\/)\s*/g, ", ")
        .replace(/\s+/g, " ")
        .trim();

    // data-read-skip: 글 속 컴포넌트가 읽지 않을 UI(범례·조작 안내 등)에 붙인다
    const SKIP = "script, style, svg, button, nav, aside, figcaption, [hidden], [aria-hidden='true'], [data-read-skip]";

    // 요소 안의 글자를 줄(<br>)과 문장으로 나누고, 문장마다 강조용 Range를 만든다
    function sentences(el: Element): { text: string; range: Range }[] {
      const lines: { node: Text; start: number }[][] = [[]];
      let text = "";
      const lineText: string[] = [""];
      const walk = (node: Node) => {
        if (node.nodeType === Node.TEXT_NODE) {
          const value = node.textContent ?? "";
          lines[lines.length - 1].push({ node: node as Text, start: lineText[lineText.length - 1].length });
          lineText[lineText.length - 1] += value;
          text += value;
          return;
        }
        if (!(node instanceof Element) || node.matches(SKIP)) return;
        if (node.tagName === "BR") { lines.push([]); lineText.push(""); return; }
        node.childNodes.forEach(walk);
      };
      el.childNodes.forEach(walk);
      const out: { text: string; range: Range }[] = [];
      lines.forEach((nodes, li) => {
        const line = lineText[li];
        const pos = (offset: number): [Text, number] | null => {
          for (let i = nodes.length - 1; i >= 0; i--) {
            if (offset >= nodes[i].start) return [nodes[i].node, Math.min(offset - nodes[i].start, nodes[i].node.length)];
          }
          return null;
        };
        const re = /\S[\s\S]*?(?:[.!?。](?=\s|$)|$)/g;
        for (const m of line.matchAll(re)) {
          const raw = m[0].trim();
          if (!raw) continue;
          const a = pos(m.index!);
          const b = pos(m.index! + m[0].trimEnd().length);
          if (!a || !b) continue;
          const range = document.createRange();
          range.setStart(a[0], a[1]);
          range.setEnd(b[0], b[1]);
          out.push({ text: raw, range });
        }
      });
      return out;
    }

    // 본문을 시맨틱 태그 순서대로 훑어 읽을 목록을 만든다. 절(section)은 h2 기준
    function collect(): { items: Item[]; sections: string[] } {
      const items: Item[] = [];
      const sections = [document.querySelector("h1")?.textContent?.trim() ?? ""];
      const push = (el: Element, parts: { text: string; range: Range | null }[]) =>
        parts.forEach((p) => { const text = speakable(p.text); if (text) items.push({ text, range: p.range, el, section: sections.length - 1 }); });
      const visit = (el: Element) => {
        if (el.matches(SKIP)) return;
        // 화면에 그려지지 않는 요소(좁은 화면 전용 안내 등)는 읽지 않는다
        if (el instanceof HTMLElement && el.getClientRects().length === 0) return;
        const tag = el.tagName;
        // 접힌 details(예: "이 글을 쓰게 된 이유")는 독자가 펼치지 않은 부가 내용이므로 제목까지 건너뛴다. 펼쳐 두면 모두 읽는다
        if (tag === "DETAILS" && !(el as HTMLDetailsElement).open) return;
        if (/^H[2-4]$/.test(tag)) {
          if (tag === "H2") sections.push(el.textContent?.trim() ?? "");
          push(el, sentences(el));
          return;
        }
        if (tag === "TABLE") {
          const heads = Array.from(el.querySelectorAll("thead th")).map((th) => th.textContent?.trim() ?? "");
          el.querySelectorAll("tbody tr").forEach((tr) => {
            const cells = Array.from(tr.children).map((td, i) => {
              const value = sentences(td).map((s) => s.text).join(" ");
              return heads[i] ? `${heads[i]}: ${value}` : value;
            });
            // 셀 끝에 이미 문장부호가 있으면 마침표를 덧붙이지 않는다
            const range = document.createRange();
            range.selectNodeContents(tr);
            push(tr, [{ text: cells.map((c, i) => (i < cells.length - 1 && !/[.!?。]$/.test(c) ? `${c}.` : c)).join(" "), range }]);
          });
          return;
        }
        if (tag === "FIGURE") {
          const label = el.querySelector("[aria-label][role]")?.getAttribute("aria-label") ?? el.querySelector("img")?.getAttribute("alt");
          if (label) push(el, [{ text: `${labels.figure}. ${label}`, range: null }]);
          return;
        }
        const leaf = tag === "P" || tag === "SUMMARY" || tag === "DT" || tag === "DD" || (tag === "LI" && !el.querySelector("p, ul, ol, table"));
        if (leaf) { push(el, sentences(el)); return; }
        Array.from(el.children).forEach(visit);
      };
      Array.from(body!.children).forEach(visit);
      return { items, sections };
    }

    let items: Item[] = [];
    let sections: string[] = [];
    let index = 0;
    let run = 0;
    let playing = false;
    let voice: SpeechSynthesisVoice | undefined;
    // Chrome은 발화 객체가 가비지 컬렉션되면 onend를 부르지 않으므로 읽는 동안 참조를 붙잡아 둔다
    let utterance: SpeechSynthesisUtterance | null = null;

    // 읽기 속도: 버튼을 누를 때마다 다음 값으로 바뀐다. 고른 값은 이 브라우저에만 기억한다
    const RATES = [0.75, 1, 1.25, 1.5, 2];
    const RATE_KEY = "read-aloud-rate";
    const rateButton = bar.querySelector<HTMLButtonElement>(".ra-rate")!;
    let rate = 1;
    try { const saved = Number(localStorage.getItem(RATE_KEY)); if (RATES.includes(saved)) rate = saved; } catch {}
    const showRate = () => {
      rateButton.textContent = `${rate}×`;
      rateButton.setAttribute("aria-label", `${rateButton.title} ${rate}×`);
    };
    showRate();

    // 기기 내장 음성을 먼저 고른다. Chrome의 네트워크 음성은 긴 문장(표의 행 등)을 15초 무렵에 끊는 문제가 있다
    const pickVoice = () => {
      const voices = speech.getVoices().filter((v) => v.lang.toLowerCase().startsWith(lang));
      return voices.find((v) => v.localService) ?? voices[0];
    };
    const waitVoices = () => new Promise<void>((resolve) => {
      if (speech.getVoices().length) return resolve();
      const done = () => { speech.removeEventListener("voiceschanged", done); resolve(); };
      speech.addEventListener("voiceschanged", done);
      setTimeout(done, 1500);
    });

    // 좁은 화면에서는 개념 카드 패널이 위에 붙어 있으므로 그 아래를 보이는 영역으로 본다
    function reveal(item: Item) {
      const rect = (item.range ?? item.el).getBoundingClientRect();
      const aside = document.getElementById("post-aside");
      const asideRect = aside && !aside.hidden && getComputedStyle(aside).position === "sticky" ? aside.getBoundingClientRect() : null;
      // 좁은 화면(패널이 전체 폭)에서는 스크롤한 뒤 패널이 위에 붙으므로 아직 붙기 전이어도 패널 높이만큼 비워 둔다
      const top = asideRect && asideRect.width > window.innerWidth / 2 ? asideRect.height : 0;
      // 화면 하단에 떠 있는 조작 바 높이만큼 아래쪽도 비워 둔다
      const bottom = window.innerHeight - (bar.hidden ? 0 : bar.getBoundingClientRect().height + 20);
      if (rect.top >= top + 8 && rect.bottom <= bottom - 8) return;
      // 탭이 백그라운드면 애니메이션이 멈춰 부드러운 스크롤이 진행되지 않으므로 바로 이동한다
      const smooth = document.visibilityState === "visible" && !matchMedia("(prefers-reduced-motion: reduce)").matches;
      // 보이는 영역보다 긴 항목(좁은 화면의 표 행 등)은 첫 줄이 보이게 위쪽에 맞추고, 나머지는 위에서 1/3 지점에 둔다
      const room = bottom - top;
      const target = rect.height > room * 0.6 ? top + 8 : top + room / 3;
      window.scrollBy({ top: rect.top - target, behavior: smooth ? "smooth" : "auto" });
    }

    function mark(item: Item | null) {
      if (!highlights) return;
      if (item?.range) highlights.set("read-aloud", new Highlight(item.range));
      else highlights.delete("read-aloud");
    }

    function show() {
      const item = items[index];
      if (!item) return;
      status.textContent = `${item.section + 1}/${sections.length} · ${sections[item.section]}`;
    }

    function speak(i: number) {
      const token = ++run;
      speech.cancel();
      index = i;
      const item = items[i];
      if (!item) return stop();
      mark(item);
      show(); // 상태 글자가 줄 높이를 바꿀 수 있으므로 스크롤 위치를 재기 전에 먼저 바꾼다
      reveal(item);
      const u = (utterance = new SpeechSynthesisUtterance(item.text));
      u.lang = voice?.lang ?? lang;
      u.rate = rate;
      if (voice) u.voice = voice;
      u.onend = () => { if (token === run && playing) speak(i + 1); };
      u.onerror = (e) => { if (token === run && playing && e.error !== "interrupted" && e.error !== "canceled") speak(i + 1); };
      speech.speak(u);
    }

    function setPlaying(on: boolean) {
      playing = on;
      const label = on ? labels.pause : labels.resume;
      toggle.setAttribute("aria-label", label);
      toggle.title = label;
      toggle.classList.toggle("is-paused", !on);
    }

    function stop() {
      run++;
      playing = false;
      speech.cancel();
      utterance = null;
      mark(null);
      bar.hidden = true;
      idle.hidden = false;
      status.textContent = "";
    }

    const sectionStart = (s: number) => Math.max(0, items.findIndex((it) => it.section >= s));

    start.addEventListener("click", async () => {
      await waitVoices();
      voice = pickVoice();
      if (!voice) { notice.textContent = labels.noVoice; return; }
      ({ items, sections } = collect());
      if (!items.length) return;
      notice.textContent = "";
      idle.hidden = true;
      bar.hidden = false;
      setPlaying(true);
      speak(0);
    });
    toggle.addEventListener("click", () => {
      if (playing) { setPlaying(false); run++; speech.cancel(); }
      else { setPlaying(true); speak(index); }
    });
    bar.querySelector(".ra-prev")!.addEventListener("click", () => {
      const current = items[index]?.section ?? 0;
      const first = sectionStart(current);
      setPlaying(true);
      speak(index > first ? first : sectionStart(Math.max(0, current - 1)));
    });
    bar.querySelector(".ra-next")!.addEventListener("click", () => {
      const next = items.findIndex((it) => it.section > (items[index]?.section ?? 0));
      if (next < 0) return stop();
      setPlaying(true);
      speak(next);
    });
    bar.querySelector(".ra-stop")!.addEventListener("click", stop);
    rateButton.addEventListener("click", () => {
      rate = RATES[(RATES.indexOf(rate) + 1) % RATES.length];
      showRate();
      try { localStorage.setItem(RATE_KEY, String(rate)); } catch {}
      // 읽는 중이면 지금 문장을 새 속도로 다시 읽는다. 일시정지 중이면 다음에 읽을 때 적용된다
      if (playing) speak(index);
    });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !bar.hidden) stop(); });
    window.addEventListener("pagehide", () => speech.cancel());

    // 폰에서 다른 앱으로 나가면 운영체제가 음성을 멈추지만 onend는 오지 않아, 돌아왔을 때 버튼만 '재생 중'으로 남는다.
    // 화면이 다시 보이면 실제 음성 상태를 확인해 멈춰 있으면 지금 문장에서 '계속 읽기'로 바꾼다.
    // 데스크톱처럼 백그라운드에서도 계속 읽고 있었다면 그대로 둔다
    function syncWithEngine() {
      if (!playing || document.visibilityState !== "visible") return;
      setTimeout(() => {
        if (!playing || (speech.speaking && !speech.paused)) return;
        run++;
        speech.cancel();
        setPlaying(false);
      }, 400);
    }
    document.addEventListener("visibilitychange", syncWithEngine);
    window.addEventListener("pageshow", syncWithEngine);
  }
</script>

<style>
  /* 본문 끝의 sticky 도크: 본문을 보는 동안 화면 하단에 붙는다. 도크 자체는 클릭을 통과시켜 뒤의 글을 가리는 면적을 버튼만큼으로 줄인다 */
  .ra-dock {
    position: sticky;
    bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    z-index: 5;
    display: flex;
    justify-content: flex-end;
    margin-top: 32px;
    pointer-events: none;
  }

  .ra-dock[hidden],
  .ra-idle[hidden] {
    display: none;
  }

  .ra-idle,
  .ra-bar {
    pointer-events: auto;
  }

  .ra-idle {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ra-notice {
    padding: 6px 10px;
    border-radius: 10px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.85rem;
    box-shadow: 0 4px 12px -8px rgb(0 0 0 / 0.35);
  }

  .ra-notice:empty {
    display: none;
  }

  .ra-start {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px 0 14px;
    border: 0;
    border-radius: 22px;
    background: var(--accent);
    color: var(--surface);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    box-shadow: 0 8px 20px -10px rgb(0 0 0 / 0.45);
    cursor: pointer;
  }

  .ra-start:hover {
    opacity: 0.92;
  }

  .ra-start svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* 재생 중 조작 바: 도크 폭(본문 칼럼)을 채운다 */
  .ra-bar {
    flex: 1;
    display: grid;
    gap: 6px;
    padding: 8px 10px 10px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: 0 8px 24px -12px rgb(0 0 0 / 0.35);
  }

  .ra-bar[hidden] {
    display: none;
  }

  /* 절 이름이 길어도 한 줄로 둔다. 줄 수가 바뀌면 바 높이가 흔들린다 */
  .ra-status {
    margin: 0;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.4;
    text-align: center;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .ra-controls {
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  /* 폰에서 누르기 쉽게 44px 이상의 아이콘 버튼 */
  .ra-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 48px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }

  .ra-icon:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .ra-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .ra-toggle {
    width: 60px;
    border-color: var(--accent);
    background: var(--accent);
    color: var(--surface);
  }

  .ra-toggle:hover {
    color: var(--surface);
    opacity: 0.9;
  }

  .ra-toggle .ra-i-play,
  .ra-toggle.is-paused .ra-i-pause {
    display: none;
  }

  .ra-toggle.is-paused .ra-i-play {
    display: inline;
  }

  .ra-rate {
    width: 56px;
  }
</style>

<style is:global>
  ::highlight(read-aloud) {
    background-color: var(--accent-soft);
    color: var(--text);
  }
</style>
