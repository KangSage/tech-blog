---
// Foundry 개념 지도: 위→아래 데이터 흐름 그림 + 개념 카드.
// 카드는 모두 빌드 시 HTML로 렌더링되고(JS 없이도 전부 보임), 스크립트가 켜지면 카드 패널을
// 글 페이지의 #post-aside(넓은 화면은 오른쪽 사이드, 좁은 화면은 상단 고정)로 옮겨 하나씩 전환한다.
import { concepts, layerLabels, type Layer } from "./concepts";

const layers = Object.entries(layerLabels) as [Layer, string][];
// 개념 지도 그림에서 층별 세로 구간 (viewBox 좌표)
const bands: { layer: Layer; top: number; bottom: number }[] = [
  { layer: "data", top: 2, bottom: 248 },
  { layer: "onto", top: 251, bottom: 400 },
  { layer: "logic", top: 403, bottom: 494 },
  { layer: "app", top: 497, bottom: 666 },
  { layer: "ops", top: 669, bottom: 742 },
];
const groups = layers.map(([layer, label]) => ({ layer, label, items: concepts.filter((c) => c.layer === layer) }));
// 마침표 등으로 끝나는 문장마다 줄을 바꿔 보여준다
const sentences = (text: string) => text.split(/(?<=[.!?])\s+/);
---

<div class="fcm" data-fcm>
  <ul class="legend" aria-label="색 구분">
    {layers.map(([layer, label]) => <li class={`l-${layer}`}><i></i>{label}</li>)}
  </ul>

  <div class="explore">
    <p class="map-scroll-hint">그림을 좌우로 밀어서 볼 수 있습니다.</p>
    <figure class="fig" id="concept-map">
      <svg class="map" viewBox="-64 0 584 744" role="group" aria-label="Foundry 흐름: Data Connection이 외부 데이터를 가져오고, Python transform·Pipeline Builder가 Build로 Dataset을 만들며, Funnel이 Ontology로 인덱싱합니다. Action·Function·Compute module·Automate·AIP Logic이 Ontology를 읽고 쓰고, Workshop·React 앱·분석 앱이 이를 사용합니다. Project·Role·Marking이 전체를 감쌉니다.">
        <defs>
          <marker id="fcm-ah" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
            <path class="ahp" d="M0,1 L9,5 L0,9 z"></path>
          </marker>
        </defs>

        <!-- 층 구분: 왼쪽 열에 층 이름, 층 사이에 점선. 권한·보안은 여러 층에 걸치므로 별도 구간 없음 -->
        <g class="bands" aria-hidden="true">
          {bands.map((b) => (
            <g class={`l-${b.layer}`}>
              <rect class="band-bar" x="-62" y={b.top + 4} width="3" height={b.bottom - b.top - 8} rx="1.5"></rect>
              <text class="band-label" x="-54" y={b.top + 18}>{layerLabels[b.layer]}</text>
            </g>
          ))}
          {bands.slice(1).map((b) => <line class="band-sep" x1="-62" x2="518" y1={b.top - 2} y2={b.top - 2}></line>)}
        </g>

        <!-- 권한: Project·Role·Marking이 데이터~앱 층 전체를 감싸는 테두리 -->
        <g class="node frame-node l-sec" data-id="project" tabindex="0" role="button" aria-label="Project · Role · Marking">
          <rect class="frame" x="12" y="4" width="500" height="660" rx="12"></rect>
          <rect class="box" x="18" y="638" width="150" height="20" rx="10"></rect>
          <text class="tab" x="93" y="652">Project · Role · Marking</text>
        </g>

        <!-- 데이터: 가져오기 → 가공(build) → 저장 -->
        <g class="node l-data" data-id="dc" tabindex="0" role="button" aria-label="Data Connection">
          <rect class="box" x="170" y="14" width="184" height="40" rx="8"></rect>
          <text class="t" x="262" y="31">Data Connection</text>
          <text class="s" x="262" y="47">외부 시스템 → Foundry</text>
        </g>
        <line class="ar" data-rel="dc transform" x1="236" y1="54" x2="140" y2="90" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-rel="dc pb" x1="288" y1="54" x2="384" y2="90" marker-end="url(#fcm-ah)"></line>
        <text class="lab" data-rel="dc transform pb" x="262" y="78">동기화(sync)</text>
        <g class="node l-data" data-id="transform" tabindex="0" role="button" aria-label="Python transform">
          <rect class="box" x="24" y="92" width="212" height="52" rx="8"></rect>
          <text class="t" x="130" y="116">Python transform</text>
          <text class="s" x="130" y="133">Code Repositories</text>
        </g>
        <g class="node l-data" data-id="pb" tabindex="0" role="button" aria-label="Pipeline Builder">
          <rect class="box" x="288" y="92" width="212" height="52" rx="8"></rect>
          <text class="t" x="394" y="116">Pipeline Builder</text>
          <text class="s" x="394" y="133">클릭 → transform 생성</text>
        </g>
        <line class="ar" data-rel="transform dataset" x1="130" y1="144" x2="130" y2="188" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-rel="pb dataset" x1="394" y1="144" x2="282" y2="188" marker-end="url(#fcm-ah)"></line>
        <g class="node l-data" data-id="builds" data-rel="builds transform pb dataset" tabindex="0" role="button" aria-label="Builds · Schedules">
          <rect class="box" x="148" y="156" width="140" height="22" rx="11"></rect>
          <text class="t sm" x="218" y="171">Builds · Schedules</text>
        </g>
        <g class="node l-data" data-id="dataset" tabindex="0" role="button" aria-label="Dataset">
          <rect class="box" x="24" y="190" width="276" height="52" rx="8"></rect>
          <text class="t" x="162" y="214">Dataset</text>
          <text class="s" x="162" y="231">트랜잭션 · SNAPSHOT / APPEND …</text>
        </g>
        <g class="node l-data" data-id="media" tabindex="0" role="button" aria-label="Media set">
          <rect class="box" x="324" y="190" width="176" height="52" rx="8"></rect>
          <text class="t" x="412" y="214">Media set</text>
          <text class="s" x="412" y="231">파일 · 불변 아이템</text>
        </g>

        <!-- 온톨로지: 인덱싱 → Ontology -->
        <line class="ar" data-rel="dataset funnel" x1="162" y1="242" x2="162" y2="256"></line>
        <g class="node l-onto" data-id="funnel" tabindex="0" role="button" aria-label="Funnel 인덱싱">
          <rect class="box" x="96" y="256" width="132" height="24" rx="12"></rect>
          <text class="t sm" x="162" y="272">Funnel 인덱싱</text>
        </g>
        <line class="ar" data-rel="funnel onto" x1="162" y1="280" x2="162" y2="298" marker-end="url(#fcm-ah)"></line>
        <g class="node link l-onto" data-id="funnel" data-rel="funnel onto dataset" tabindex="0" role="button" aria-label="Materialization">
          <rect class="hit" x="246" y="246" width="110" height="52"></rect>
          <line class="ar dash" x1="256" y1="300" x2="256" y2="244" marker-end="url(#fcm-ah)"></line>
          <text class="lab as" x="262" y="276">Materialization</text>
        </g>
        <g class="node link l-data" data-id="media" data-rel="media onto" tabindex="0" role="button" aria-label="media reference">
          <rect class="hit" x="404" y="246" width="60" height="52"></rect>
          <line class="ar dash" x1="412" y1="242" x2="412" y2="298" marker-end="url(#fcm-ah)"></line>
          <text class="lab as" x="418" y="266">media</text>
          <text class="lab as" x="418" y="279">ref</text>
        </g>
        <g class="node l-onto" data-id="onto" tabindex="0" role="button" aria-label="Ontology">
          <rect class="box" x="24" y="300" width="476" height="96" rx="10"></rect>
          <text class="tb" x="262" y="324">Ontology (OSv2)</text>
          <text class="s" x="262" y="342">Object type · Property · Link type · Object set</text>
        </g>
        <g class="node l-onto" data-id="interfaces" data-rel="interfaces onto" tabindex="0" role="button" aria-label="Interfaces">
          <rect class="box" x="40" y="356" width="150" height="28" rx="6"></rect>
          <text class="t sm" x="115" y="374">Interfaces</text>
        </g>
        <g class="node l-sec" data-id="osp" data-rel="osp onto" tabindex="0" role="button" aria-label="Object security policy">
          <rect class="box" x="334" y="356" width="154" height="28" rx="6"></rect>
          <text class="t sm" x="411" y="374">Object security policy</text>
        </g>

        <!-- 로직 → 온톨로지: 아래 층이 위 층을 읽고 쓴다 -->
        <line class="ar" data-rel="action onto" x1="66" y1="434" x2="66" y2="398" marker-end="url(#fcm-ah)"></line>
        <text class="lab as" data-rel="action onto" x="72" y="419">쓰기(편집)</text>
        <line class="ar" data-rel="function onto" x1="156" y1="434" x2="156" y2="398" marker-end="url(#fcm-ah)"></line>
        <text class="lab as" data-rel="function onto" x="162" y="419">읽기·계산</text>
        <line class="ar dash" data-rel="cm onto" x1="254" y1="434" x2="254" y2="398" marker-end="url(#fcm-ah)"></line>
        <text class="lab as" data-rel="cm onto" x="260" y="419">서비스 유저</text>
        <line class="ar" data-rel="automate onto" x1="354" y1="434" x2="354" y2="398" marker-end="url(#fcm-ah)"></line>
        <text class="lab as" data-rel="automate onto" x="360" y="419">감시·실행</text>
        <line class="ar" data-rel="aip onto" x1="452" y1="434" x2="452" y2="398" marker-end="url(#fcm-ah)"></line>
        <text class="lab as" data-rel="aip onto" x="458" y="419">읽기·편집</text>
        <g class="node l-logic" data-id="action" tabindex="0" role="button" aria-label="Action type">
          <rect class="box" x="24" y="436" width="84" height="52" rx="8"></rect>
          <text class="t" x="66" y="460">Action type</text>
          <text class="s" x="66" y="477">+ 제출 조건</text>
        </g>
        <g class="node l-logic" data-id="function" tabindex="0" role="button" aria-label="Function">
          <rect class="box" x="116" y="436" width="80" height="52" rx="8"></rect>
          <text class="t" x="156" y="460">Function</text>
          <text class="s" x="156" y="477">TS · Python</text>
        </g>
        <g class="node l-logic" data-id="cm" tabindex="0" role="button" aria-label="Compute module">
          <rect class="box" x="204" y="436" width="100" height="52" rx="8"></rect>
          <text class="t sm" x="254" y="460">Compute module</text>
          <text class="s" x="254" y="477">Docker 컨테이너</text>
        </g>
        <g class="node l-logic" data-id="automate" tabindex="0" role="button" aria-label="Automate">
          <rect class="box" x="312" y="436" width="84" height="52" rx="8"></rect>
          <text class="t" x="354" y="460">Automate</text>
          <text class="s" x="354" y="477">조건 → 자동 실행</text>
        </g>
        <g class="node l-logic" data-id="aip" tabindex="0" role="button" aria-label="AIP Logic · AIP Chatbot Studio">
          <rect class="box" x="404" y="436" width="96" height="52" rx="8"></rect>
          <text class="t" x="452" y="460">AIP Logic</text>
          <text class="s" x="452" y="477">LLM · 챗봇</text>
        </g>

        <!-- 앱 → 로직: 앱이 로직을 호출 (Automate는 조건으로 실행되므로 호출 대상 아님) -->
        <line class="ar" data-rel="action workshop osdk" x1="66" y1="506" x2="66" y2="490" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-rel="function workshop osdk" x1="156" y1="506" x2="156" y2="490" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-rel="cm workshop osdk" x1="254" y1="506" x2="254" y2="490" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-rel="aip workshop osdk" x1="452" y1="506" x2="452" y2="490" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-rel="action function cm aip workshop osdk" data-bus x1="66" y1="506" x2="452" y2="506"></line>
        <line class="ar" data-rel="workshop action function cm aip" data-bus x1="100" y1="538" x2="100" y2="508" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-rel="osdk action function cm aip" data-bus x1="266" y1="538" x2="266" y2="508" marker-end="url(#fcm-ah)"></line>
        <text class="lab" data-rel="action function cm aip workshop osdk" data-bus x="183" y="526">앱이 로직을 호출</text>
        <g class="node l-app" data-id="workshop" tabindex="0" role="button" aria-label="Workshop">
          <rect class="box" x="24" y="540" width="152" height="52" rx="8"></rect>
          <text class="t" x="100" y="564">Workshop</text>
          <text class="s" x="100" y="581">노코드 앱 빌더</text>
        </g>
        <g class="node l-app" data-id="osdk" tabindex="0" role="button" aria-label="OSDK와 Developer Console">
          <rect class="box" x="190" y="540" width="152" height="52" rx="8"></rect>
          <text class="t" x="266" y="564">React 앱 (OSDK)</text>
          <text class="s" x="266" y="581">Developer Console</text>
        </g>
        <g class="node l-app" data-id="analytics" tabindex="0" role="button" aria-label="Contour · Quiver · Object Explorer">
          <rect class="box" x="356" y="540" width="144" height="52" rx="8"></rect>
          <text class="t" x="428" y="564">Contour · Quiver</text>
          <text class="s" x="428" y="581">Object Explorer</text>
        </g>
        <path class="ar" data-rel="analytics onto" d="M500,566 H506 V348 H502" marker-end="url(#fcm-ah)"></path>
        <line class="ar" data-rel="osdk oauth" x1="266" y1="592" x2="266" y2="606"></line>
        <g class="node l-sec" data-id="oauth" tabindex="0" role="button" aria-label="OAuth">
          <rect class="box" x="204" y="606" width="124" height="26" rx="13"></rect>
          <text class="t sm" x="266" y="623">OAuth · PKCE</text>
        </g>
        <text class="lab" data-rel="oauth osdk" x="300" y="652">토큰 = 사용자 권한 ∩ 앱 제한 ∩ 요청 scope</text>

        <!-- 운영 -->
        <text class="lab as" x="24" y="688">모든 층의 변경과 배포를 관리</text>
        <g class="node l-ops" data-id="oma" tabindex="0" role="button" aria-label="Ontology Manager">
          <rect class="box" x="24" y="696" width="152" height="40" rx="8"></rect>
          <text class="t sm" x="100" y="720">Ontology Manager</text>
        </g>
        <g class="node l-ops" data-id="branch" tabindex="0" role="button" aria-label="Global Branching">
          <rect class="box" x="190" y="696" width="152" height="40" rx="8"></rect>
          <text class="t sm" x="266" y="720">Global Branching</text>
        </g>
        <g class="node l-ops" data-id="market" tabindex="0" role="button" aria-label="Marketplace">
          <rect class="box" x="356" y="696" width="144" height="40" rx="8"></rect>
          <text class="t sm" x="428" y="720">Marketplace</text>
        </g>
      </svg>
      <figcaption>
        <ul class="map-legend">
          <li><svg viewBox="0 0 30 10" aria-hidden="true"><line class="lg-line" x1="1" y1="5" x2="23" y2="5"></line><path class="lg-head" d="M22,1 L29,5 L22,9 z"></path></svg>실선: 데이터가 흐르는 방향, 또는 아래 층이 위 층을 호출·읽기·쓰기 하는 방향</li>
          <li><svg viewBox="0 0 30 10" aria-hidden="true"><line class="lg-line lg-dash" x1="1" y1="5" x2="23" y2="5"></line><path class="lg-head" d="M22,1 L29,5 L22,9 z"></path></svg>점선: 역방향 저장(Materialization), 파일 참조(media ref), 서비스 유저 권한으로 접근</li>
          <li><svg viewBox="0 0 30 10" aria-hidden="true"><rect class="lg-frame" x="1" y="1" width="28" height="8" rx="3"></rect></svg>호박색 점선 테두리: Project · Role · Marking 권한이 데이터부터 앱까지 전체를 감쌈</li>
        </ul>
        <p class="map-hint">개념을 고르면 그 개념과 연결된 상자와 화살표만 진하게 표시됩니다.</p>
      </figcaption>
    </figure>

    <section class="panel" aria-label="개념 카드">
      <div class="index" hidden>
      <div class="chips" aria-label="개념 목록">
        {groups.map((g) => (
          <div class={`chip-group l-${g.layer}`} role="group" aria-label={g.label}>
            <span class="glabel">{g.label}</span>
            <span class="gitems">
              {g.items.map((c) => (
                <button type="button" class={`chip l-${c.layer}`} data-chip={c.id} aria-label={c.title} aria-pressed="false">
                  <i></i>{c.short}
                </button>
              ))}
            </span>
          </div>
        ))}
      </div>
      <button type="button" class="index-toggle" aria-expanded="false">전체 목록 ▾</button>
      </div>

      <div class="cards" aria-live="polite">
        {concepts.map((c) => (
          <article class={`card l-${c.layer}`} id={`concept-${c.id}`} data-card={c.id}>
            <div class="cmeta">
              <span class="num">{layerLabels[c.layer]}</span>
            </div>
            <h3 class="ct">{c.title}</h3>
            <p class="lead">{sentences(c.lead).map((s, i) => <>{i > 0 && <br />}{s}</>)}</p>
            <div class="cbody detail">
            <div class="ana">
              <div class="ana-head">
                <b>비유로 보면</b>
                <span class="ana-tabs" role="group" aria-label="비유 관점" hidden>
                  <button type="button" data-view="dev" aria-pressed="true">개발자</button>
                  <button type="button" data-view="everyday" aria-pressed="false">일반</button>
                </span>
              </div>
              <p class="ana-dev"><span class="ana-kind">개발자: </span>{sentences(c.analogy).map((s, i) => <>{i > 0 && <br />}{s}</>)}</p>
              <p class="ana-everyday"><span class="ana-kind">일반: </span>{sentences(c.everyday).map((s, i) => <>{i > 0 && <br />}{s}</>)}</p>
            </div>
            <ul class="pts">
              {c.points.map((p) => <li><span>{sentences(p).map((s, i) => <>{i > 0 && <br />}{s}</>)}</span></li>)}
            </ul>
            {c.warn && <p class="warn"><b>주의</b><span>{sentences(c.warn).map((s, i) => <>{i > 0 && <br />}{s}</>)}</span></p>}
            </div>
            <div class="docs detail">
              <a class="doc" href={c.doc} target="_blank" rel="noopener noreferrer">공식 문서 ↗</a>
              {c.related.map((r) => <a class="rel" href={r.href} target="_blank" rel="noopener noreferrer">{r.label} ↗</a>)}
            </div>
          </article>
        ))}
      </div>

      <div class="nav" hidden>
        <a class="back" href="#concept-map">↑ 지도</a>
        <button type="button" class="more" aria-expanded="false">자세히 ▾</button>
        <button type="button" class="step" data-step="-1">이전</button>
        <button type="button" class="step" data-step="1">다음</button>
      </div>
    </section>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-fcm]");
  const panel = root?.querySelector<HTMLElement>(".panel");
  if (root && panel) {
    const cards = Array.from(panel.querySelectorAll<HTMLElement>("[data-card]"));
    const ids = cards.map((card) => card.dataset.card ?? "");
    const chips = panel.querySelector<HTMLElement>(".chips");
    const more = panel.querySelector<HTMLButtonElement>(".more");
    const indexToggle = panel.querySelector<HTMLButtonElement>(".index-toggle");
    let current = 0;

    // 카드 패널을 글 페이지의 고정 자리로 옮긴다. 자리가 없으면 그림 옆(제자리)에서 동작
    const aside = document.getElementById("post-aside");
    if (aside) {
      aside.append(panel);
      aside.hidden = false;
      panel.dataset.docked = "";
    }
    // 카드 id는 JS가 없을 때의 앵커용. 켜진 뒤에는 지워서 #concept-… 해시로 브라우저가 스크롤하지 않게 한다
    cards.forEach((card) => card.removeAttribute("id"));
    const scroller = aside ?? panel;
    root.dataset.enhanced = "";
    panel.dataset.enhanced = "";
    panel.querySelectorAll<HTMLElement>(".index, .nav").forEach((el) => (el.hidden = false));

    // 비유 관점(개발자/일반). 한 카드에서 고르면 모든 카드에 적용하고, 이 브라우저에 기억한다
    const VIEW_KEY = "fcm-analogy-view";
    function setView(view: string) {
      if (view !== "dev" && view !== "everyday") return;
      panel!.dataset.view = view;
      panel!.querySelectorAll<HTMLElement>("button[data-view]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.view === view)));
      try { localStorage.setItem(VIEW_KEY, view); } catch {}
      updateFade();
    }
    panel.querySelectorAll<HTMLElement>(".ana-tabs").forEach((el) => (el.hidden = false));
    let savedView = "dev";
    try { savedView = localStorage.getItem(VIEW_KEY) ?? "dev"; } catch {}
    setView(savedView);

    function setIndexOpen(open: boolean) {
      panel!.classList.toggle("index-open", open);
      if (indexToggle) {
        indexToggle.setAttribute("aria-expanded", String(open));
        indexToggle.textContent = open ? "접기 ▴" : "전체 목록 ▾";
      }
      updateFade();
    }

    // 카드 본문이 넘치면 아래쪽을 흐리게 해서 더 있다는 것을 보여준다
    function updateFade() {
      const body = cards[current]?.querySelector<HTMLElement>(".cbody");
      if (body) body.classList.toggle("has-more", body.scrollHeight - body.scrollTop - body.clientHeight > 4);
    }
    cards.forEach((card) => card.querySelector(".cbody")?.addEventListener("scroll", updateFade, { passive: true }));
    window.addEventListener("resize", updateFade);

    function setExpanded(open: boolean) {
      panel!.classList.toggle("is-expanded", open);
      if (more) {
        more.setAttribute("aria-expanded", String(open));
        more.textContent = open ? "접기 ▴" : "자세히 ▾";
      }
    }

    // 연결 강조: 고른 개념이 들어 있는 data-rel 요소와 그 요소가 잇는 개념만 진하게.
    // 모든 층에 걸친 개념(권한 테두리, 운영 도구)은 흐리게 하지 않는다
    const map = root.querySelector<SVGElement>(".map");
    const relEls = Array.from(root.querySelectorAll<SVGElement>(".map [data-rel]"));
    const nodeEls = Array.from(root.querySelectorAll<SVGElement>(".map .node"));
    const CROSS_CUTTING = new Set(["project", "oma", "branch", "market"]);
    // 처음 열었을 때는 지도 전체를 보여 주고, 사용자가 개념을 고른 뒤부터 강조한다
    let focusEnabled = false;
    function focusRelations(id: string) {
      if (!map) return;
      const focus = focusEnabled && !CROSS_CUTTING.has(id);
      map.classList.toggle("focus", focus);
      const related = new Set([id]);
      relEls.forEach((el) => {
        const ids = (el.dataset.rel ?? "").split(" ");
        const on = focus && ids.includes(id);
        el.classList.toggle("rel-on", on);
        // 공용 연결선(data-bus)은 강조만 하고, 거기 묶인 다른 개념까지 연결 대상으로 넓히지 않는다
        if (on && !el.hasAttribute("data-bus")) ids.forEach((x) => related.add(x));
      });
      nodeEls.forEach((node) => node.classList.toggle("rel-on", focus && related.has(node.dataset.id ?? "")));
    }

    function render(index: number) {
      current = index;
      const id = ids[index];
      cards.forEach((card, i) => card.classList.toggle("is-active", i === index));
      root!.querySelectorAll(".map [data-id]").forEach((node) => node.classList.toggle("sel", node.getAttribute("data-id") === id));
      focusRelations(id);
      panel!.querySelectorAll<HTMLElement>(".chip-group").forEach((group) => {
        group.classList.toggle("is-current", !!group.querySelector(`[data-chip="${id}"]`));
      });
      panel!.querySelectorAll<HTMLElement>("[data-chip]").forEach((chip) => {
        const on = chip.dataset.chip === id;
        chip.setAttribute("aria-pressed", String(on));
        if (!on) return;
        // 가로로 스크롤되는 목록(좁은 화면의 전체 줄, 넓은 화면의 접힌 층 줄)에서 선택 항목을 가운데로
        for (const row of [chips, chip.closest<HTMLElement>(".gitems")]) {
          if (!row || row.scrollWidth <= row.clientWidth) continue;
          const br = chip.getBoundingClientRect();
          const cr = row.getBoundingClientRect();
          row.scrollLeft += br.left - cr.left - (cr.width - br.width) / 2;
        }
      });
      const body = cards[index].querySelector<HTMLElement>(".cbody");
      if (body) body.scrollTop = 0;
      panel!.scrollTop = 0;
      scroller.scrollTop = 0;
      updateFade();
    }

    // 스크롤 위치는 건드리지 않고 카드만 바꾼다 (패널은 항상 화면에 고정되어 있음)
    function pick(id: string | null | undefined) {
      const index = id ? ids.indexOf(id) : -1;
      if (index < 0) return;
      focusEnabled = true;
      render(index);
      history.replaceState(null, "", `#concept-${id}`);
    }

    document.addEventListener("click", (event) => {
      const target = event.target as Element;
      if (more && target.closest(".more") === more) return setExpanded(!panel.classList.contains("is-expanded"));
      if (indexToggle && target.closest(".index-toggle") === indexToggle) return setIndexOpen(!panel.classList.contains("index-open"));
      const viewButton = target.closest<HTMLElement>("button[data-view]");
      if (viewButton && panel.contains(viewButton)) return setView(viewButton.dataset.view ?? "");
      const chip = target.closest<HTMLElement>("[data-chip]");
      if (chip) return pick(chip.dataset.chip);
      const step = target.closest<HTMLElement>("[data-step]");
      if (step && panel.contains(step)) {
        return pick(ids[(current + Number(step.dataset.step) + ids.length) % ids.length]);
      }
      const node = target.closest(".map [data-id]");
      if (node) return pick(node.getAttribute("data-id"));
      // 본문의 개념 링크(#concept-…)도 이동 없이 카드 전환으로 처리
      const link = target.closest<HTMLAnchorElement>('a[href^="#concept-"]');
      const linkId = link?.getAttribute("href")?.slice("#concept-".length);
      if (link && linkId && ids.includes(linkId)) {
        event.preventDefault();
        pick(linkId);
      }
    });

    root.querySelectorAll<HTMLElement>(".map [data-id]").forEach((node) => {
      node.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          pick(node.getAttribute("data-id"));
        }
      });
    });

    window.addEventListener("hashchange", () => pick(location.hash.replace("#concept-", "")));

    const initial = location.hash.replace("#concept-", "");
    focusEnabled = ids.includes(initial);
    render(ids.includes(initial) ? ids.indexOf(initial) : ids.indexOf("onto"));
    // #concept-… 주소로 들어오면 브라우저가 이미 옛 카드 위치로 스크롤했으므로 지도 위치로 맞춘다
    if (ids.includes(initial)) {
      window.addEventListener("load", () => {
        scroller.scrollTop = 0;
        root.scrollIntoView({ block: "start" });
      }, { once: true });
    }
  }
</script>

<style>
  /* 패널은 스크립트가 .fcm 밖(#post-aside)으로 옮기므로 색 변수를 패널에도 둔다 */
