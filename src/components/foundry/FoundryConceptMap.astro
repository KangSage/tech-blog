---
// Foundry 개념 지도: 위→아래 데이터 흐름 그림 + 개념 카드.
// 카드는 모두 빌드 시 HTML로 렌더링되고(JS 없이도 전부 보임), 스크립트가 켜지면 카드 패널을
// 글 페이지의 #post-aside(넓은 화면은 오른쪽 사이드, 좁은 화면은 상단 고정)로 옮겨 하나씩 전환한다.
// 연재 글에서는 route로 노선 하나를 켠 채 연다: <FoundryConceptMap route="access" />
import { concepts, layerLabels, type Layer } from "./concepts";
import { routes } from "./routes";
import { blogPath, withBase } from "@/lib/i18n";
import { getPublishedPosts, localeFromId, slugFromId } from "@/lib/posts";

interface Props {
  /** 처음부터 켜 둘 노선 id (routes.ts). 주소의 #route-…가 있으면 그쪽이 우선한다 */
  route?: string;
}
const { route: initialRoute } = Astro.props;
if (initialRoute && !routes.some((r) => r.id === initialRoute)) throw new Error(`[FoundryConceptMap] 없는 노선: ${initialRoute}`);

// 노선별 "자세히 다룬 글" 링크: routes.ts의 article(한국어 글 slug)이 게시된 글이어야 한다.
// 지금 보고 있는 글이 그 노선의 글이면 자기 자신으로 가는 링크는 보여 주지 않는다
const publishedKo = new Map(
  (await getPublishedPosts()).filter((p) => localeFromId(p.id) === "ko").map((p) => [slugFromId(p.id), p.data.title]),
);
const routeArticles = Object.fromEntries(
  routes.filter((r) => r.article).map((r) => {
    const title = publishedKo.get(r.article!);
    if (!title) throw new Error(`[FoundryConceptMap] 노선 ${r.id}의 article이 게시된 한국어 글이 아님: ${r.article}`);
    const href = withBase(blogPath("ko", r.article!));
    return [r.id, href.replace(/\/$/, "") === Astro.url.pathname.replace(/\/$/, "") ? null : { href, title }];
  }),
);

const layers = Object.entries(layerLabels) as [Layer, string][];
// 개념 지도 상자의 배치 (viewBox 좌표). 이름은 넣지 않는다: concepts.ts의 short/mapLines를 쓴다.
// 그리는 순서가 곧 겹침 순서라서, Ontology 안에 들어가는 상자(interfaces, osp)는 onto 뒤에 둔다.
// Data Lineage · Workflow Lineage는 원천부터 앱까지 걸치므로 CROSS_CUTTING으로 다룬다(아래 스크립트).
interface MapNode { id: string; x: number; y: number; w: number; h: number; rx?: number; cls?: string; sub?: string; edges?: string }
const mapNodes: MapNode[] = [
  { id: "vt", x: 24, y: 14, w: 126, h: 40, sub: "외부 테이블 포인터" },
  { id: "dc", x: 170, y: 14, w: 184, h: 40, sub: "외부 → Dataset·Stream 등" },
  { id: "model", x: 374, y: 14, w: 126, h: 40, cls: "t sm" },
  { id: "transform", x: 24, y: 92, w: 200, h: 52, sub: "Code Repositories 등" },
  { id: "pb", x: 300, y: 92, w: 200, h: 52, sub: "클릭 → transform 생성" },
  { id: "builds", x: 134, y: 156, w: 114, h: 22, rx: 11, cls: "t sm", edges: "builds:transform builds:pb builds:dataset" },
  { id: "dataset", x: 24, y: 190, w: 246, h: 52, sub: "가져온 데이터·가공 결과는 각각 별도 Dataset" },
  { id: "stream", x: 282, y: 190, w: 92, h: 52, sub: "저지연 레코드" },
  { id: "media", x: 386, y: 190, w: 114, h: 52, sub: "파일 · 버전 이력" },
  { id: "rv", x: 156, y: 256, w: 104, h: 24, rx: 6, cls: "t sm" },
  { id: "funnel", x: 156, y: 292, w: 148, h: 24, rx: 12, cls: "t sm" },
  { id: "onto", x: 24, y: 336, w: 476, h: 96, rx: 10, cls: "tb", sub: "OSv2 · Object type · Property · Link type · Object set" },
  { id: "interfaces", x: 40, y: 392, w: 150, h: 28, rx: 6, cls: "t sm", edges: "interfaces:onto" },
  { id: "osp", x: 334, y: 392, w: 154, h: 28, rx: 6, cls: "t sm", edges: "osp:onto" },
  { id: "action", x: 24, y: 472, w: 80, h: 52, sub: "+ 제출 조건" },
  { id: "function", x: 110, y: 472, w: 76, h: 52, sub: "TS · Python" },
  { id: "cm", x: 192, y: 472, w: 104, h: 52, cls: "t sm", sub: "Docker 컨테이너" },
  { id: "automate", x: 302, y: 472, w: 80, h: 52, sub: "조건 → 실행" },
  { id: "aip", x: 388, y: 472, w: 92, h: 52, sub: "LLM · 챗봇" },
  { id: "workshop", x: 24, y: 576, w: 148, h: 52, sub: "노코드 앱 빌더" },
  { id: "osdk", x: 184, y: 576, w: 170, h: 52 },
  { id: "analytics", x: 366, y: 576, w: 134, h: 52 },
  { id: "objectviews", x: 24, y: 638, w: 140, h: 28, rx: 6, cls: "t sm" },
  { id: "oauth", x: 207, y: 642, w: 124, h: 26, rx: 13, cls: "t sm" },
  { id: "omcp", x: 366, y: 638, w: 134, h: 42, rx: 6, cls: "t sm", sub: "외부 AI 에이전트용" },
  { id: "oma", x: 24, y: 732, w: 152, h: 40, cls: "t sm" },
  { id: "branch", x: 190, y: 732, w: 152, h: 40, cls: "t sm" },
  { id: "market", x: 356, y: 732, w: 144, h: 40, cls: "t sm" },
  { id: "lineage", x: 24, y: 782, w: 152, h: 44, cls: "t sm" },
  { id: "approvals", x: 190, y: 782, w: 152, h: 44, cls: "t sm" },
];

// 빌드 시 검사: 카드와 지도 상자가 1:1로 대응하고, 여러 줄 이름이 목록 이름과 같은지 확인한다.
// 어긋나면 빌드를 멈춰서, 개념을 추가·수정할 때 지도를 빠뜨리는 일을 막는다.
const byId = Object.fromEntries(concepts.map((c) => [c.id, c]));
{
  const drawn = new Set([...mapNodes.map((n) => n.id), "project"]); // project는 테두리로 따로 그린다
  const problems = [
    ...concepts.filter((c) => !drawn.has(c.id)).map((c) => `지도에 상자가 없는 개념: ${c.id}`),
    ...[...drawn].filter((id) => !byId[id]).map((id) => `카드 데이터가 없는 지도 상자: ${id}`),
    ...concepts
      .filter((c) => c.mapLines && c.mapLines.join(" · ").replace(/\s|·/g, "") !== c.short.replace(/\s|·/g, ""))
      .map((c) => `mapLines를 이으면 short와 달라지는 개념: ${c.id}`),
    // 카드가 여러 기능을 다루면 기능마다 공식 문서 버튼을 둔다: 버튼 이름을 이으면 title과 같아야 한다
    ...concepts
      .filter((c) => (typeof c.doc === "string" ? c.title.includes(" · ") : c.doc.map((d) => d.label).join(" · ") !== c.title))
      .map((c) => `공식 문서 버튼이 title의 기능과 맞지 않는 개념: ${c.id}`),
    // 관점(노선): 단계는 있는 개념만, 한 노선에서 개념은 한 번만, 강조할 선은 양 끝이 모두 단계에 있어야 한다
    ...routes.flatMap((r) => {
      const stepIds = r.steps.flatMap((s) => s.ids);
      return [
        ...stepIds.filter((id) => !byId[id]).map((id) => `노선 ${r.id}에 없는 개념: ${id}`),
        ...stepIds.filter((id, i) => stepIds.indexOf(id) !== i).map((id) => `노선 ${r.id}에 두 번 나오는 개념: ${id}`),
        ...r.edges.filter(([a, b]) => !stepIds.includes(a) || !stepIds.includes(b)).map(([a, b]) => `노선 ${r.id}의 선 양 끝이 단계에 없음: ${a}:${b}`),
        ...(r.sources.length ? [] : [`근거 문서가 없는 노선: ${r.id}`]),
      ];
    }),
  ];
  if (problems.length) throw new Error(`[FoundryConceptMap] ${problems.join("; ")}`);
}

// 개념 지도 그림에서 층별 세로 구간 (viewBox 좌표)
const bands: { layer: Layer; top: number; bottom: number }[] = [
  { layer: "data", top: 2, bottom: 284 },
  { layer: "onto", top: 287, bottom: 436 },
  { layer: "logic", top: 439, bottom: 530 },
  { layer: "app", top: 533, bottom: 702 },
  { layer: "ops", top: 705, bottom: 832 },
];
const groups = layers.map(([layer, label]) => ({ layer, label, items: concepts.filter((c) => c.layer === layer) }));
// 마침표 등으로 끝나는 문장마다 줄을 바꿔 보여준다
const sentences = (text: string) => text.split(/(?<=[.!?])\s+/);
// 노선 번호 자리: 상자의 왼쪽 위 모서리. 권한 테두리(project)는 이름표의 왼쪽 위
const badges = [...mapNodes.map((n) => ({ id: n.id, x: n.x, y: n.y })), { id: "project", x: 356, y: 818 }];
// 앱과 로직 사이의 공용 가로선은 세로선이 만나는 곳마다 구간으로 나눠 그린다.
// 연결 쌍은 앱의 세로선부터 대상의 세로선까지 지나는 구간에만 실어서, 고른 연결이 지나지 않는 구간은 흐리게 남는다.
// x는 아래 그림의 세로선 위치와 같아야 한다 (앱: 아래에서 올라오는 선, 대상: 로직 상자와 Ontology로 올라가는 선)
const busY = 552;
const busApps: Record<string, number> = { workshop: 98, osdk: 269, analytics: 470 };
const busTargets: Record<string, number> = { action: 64, function: 148, cm: 244, aip: 434, onto: 494 };
const busPairs = [
  "workshop:action", "workshop:function", "workshop:cm", "workshop:aip", "workshop:onto",
  "osdk:action", "osdk:function", "osdk:cm", "osdk:aip", "osdk:onto",
  "analytics:action", "analytics:function", "analytics:onto",
];
const busStops = [...new Set([...Object.values(busApps), ...Object.values(busTargets)])].sort((a, b) => a - b);
const busSegments = busStops.slice(0, -1).map((x1, i) => {
  const x2 = busStops[i + 1];
  const edges = busPairs.filter((pair) => {
    const [app, target] = pair.split(":");
    return Math.min(busApps[app], busTargets[target]) <= x1 && x2 <= Math.max(busApps[app], busTargets[target]);
  });
  return { x1, x2, edges: edges.join(" ") };
});
---

<div class="fcm" data-fcm data-initial-route={initialRoute}>
  <ul class="legend" aria-label="색 구분" data-read-skip>
    {layers.map(([layer, label]) => <li class={`l-${layer}`}><i></i>{label}</li>)}
  </ul>

  <!-- 관점(노선) 보기: 스크립트가 켜져야 동작하므로 처음에는 숨긴다.
       고른 노선의 질문과 단계 설명은 글 내용이라 읽어 주기가 읽고, 선택 버튼과 조작 안내만 data-read-skip으로 뺀다 -->
  <div class="routes" data-routes hidden>
    <div class="route-tabs" role="group" aria-label="관점으로 보기" data-read-skip>
      <span class="route-label">관점으로 보기</span>
      <button type="button" data-route="" aria-pressed="true">전체</button>
      {routes.map((r) => <button type="button" data-route={r.id} aria-pressed="false">{r.label}</button>)}
    </div>
    <!-- 질문은 지도 위에, 단계 설명과 근거 문서는 지도 바로 아래에 둬서 고르자마자 지도가 보이게 한다 -->
    {routes.map((r) => <p class="route-q" data-route-q={r.id} hidden>{r.question}</p>)}
    <p class="route-hint" data-read-skip>{sentences('번호는 질문을 따라 읽는 순서이고 "/"로 나뉜 개념은 그중 하나를 쓰는 갈래입니다. 관점을 고른 동안 개념을 누르면 카드만 바뀌고 "전체"를 누르면 개념별 연결 강조로 돌아갑니다.').map((t, k) => <>{k > 0 && <br />}{t}</>)}</p>
  </div>

  <div class="explore">
    <p class="map-scroll-hint" data-read-skip>그림을 좌우로 밀어서 볼 수 있습니다.</p>
    <figure class="fig" id="concept-map">
      <!-- 좁은 화면에서는 그림만 좌우로 밀리게 감싼다. 범례(figcaption)까지 함께 밀리면 왼쪽이 잘려 읽을 수 없다 -->
      <div class="map-scroll">
      <svg class="map" viewBox="-64 0 584 846" role="group" aria-label="Foundry 흐름: Data Connection이 외부 데이터를 Dataset·Stream·Media set으로 가져오거나 Virtual table로 연결하고 Python transform·Pipeline Builder가 그 Dataset을 입력으로 Build해 새 Dataset을 만듭니다. Restricted view는 Dataset에서 사용자가 볼 수 있는 행만 보이게 하며 Funnel이 Dataset·Restricted view·Stream 같은 datasource를 Ontology로 인덱싱합니다. 사용자는 필요하면 Materialization으로 datasource의 데이터와 편집을 합친 별도 출력 Dataset(입력 datasource에 따라 Restricted view)을 만들 수 있고 Object의 media reference는 Media set의 파일을 가리킵니다. 로직 층에서 Ontology에 쓰는 것은 Action이고 Function·Compute module·Automate·AIP Logic은 Ontology를 읽습니다. 예외로 Automate의 Logic effect는 staged writes를 끈 Logic 함수의 편집을 Action 없이 적용할 수 있습니다. Workshop과 OSDK · Developer Console로 만든 앱은 Ontology를 사용하고 Contour · Quiver · Object Explorer는 Ontology와 Dataset을 함께 사용합니다. Object Views는 Object 하나의 정보를 모아 보여 주고 외부 AI 에이전트는 Ontology MCP로 Ontology를 읽고 Action을 실행합니다. Models는 Modeling Objectives나 direct model deployment로 모델을 배포해 Function과 파이프라인에서 씁니다. 맨 아래 운영 줄의 Ontology Manager, Global Branching, Marketplace, Data Lineage · Workflow Lineage는 여러 층의 정의·변경·배포와 의존 관계 확인을 다루고 Approvals · Checkpoints는 Project 접근 요청이나 Ontology proposal 같은 승인과 민감한 작업의 사유 기록을 다룹니다. Project · Role · Marking이 전체를 감쌉니다.">
        <defs>
          <marker id="fcm-ah" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
            <path class="ahp" d="M0,1 L9,5 L0,9 z"></path>
          </marker>
        </defs>

        <!-- 층 구분: 왼쪽 열에 층 이름, 층 사이에 점선. 권한·보안은 여러 층에 걸치므로 별도 구간 없음 -->
        <g class="bands" aria-hidden="true">
          {bands.map((b) => (
            <g class={`l-${b.layer}`}>
              <rect class="band-bar" x="-62" y={b.top + 4} width="3" height={b.bottom - b.top - 8} rx="1.5"></rect>
              <text class="band-label" x="-54" y={b.top + 18}>{layerLabels[b.layer]}</text>
            </g>
          ))}
          {bands.slice(1).map((b) => <line class="band-sep" x1="-62" x2="518" y1={b.top - 2} y2={b.top - 2}></line>)}
        </g>

        <!-- 권한: Project에 저장한 리소스에는 층과 관계없이 Project·Role·Marking 권한이 적용됨을 나타내는 테두리(운영 층 포함).
             이름표는 테두리 아래 선에 걸쳐 둬서 운영 층의 개념 상자가 아니라 테두리의 이름임을 보인다 -->

        <a class="node frame-node l-sec" href="#concept-project" data-id="project" aria-label={byId.project.title}>
          <rect class="frame" x="12" y="4" width="500" height="826" rx="12"></rect>
          <rect class="box" x="356" y="818" width="150" height="24" rx="12"></rect>
          <text class="tab" x="431" y="834">{byId.project.short}</text>
        </a>

        <!-- 데이터: 가져오기 → 가공(build) → 저장 -->
        <!-- batch sync는 sync를 만들 때 함께 생긴 원본 Dataset에 쓰고 streaming sync는 Stream에 쓴다(세로선 두 개).
             transform·Pipeline Builder는 보통 batch sync가 쓴 원본 Dataset을 입력으로 읽으므로 양옆 사선은 Data Connection 상자가 아니라
             batch sync 선에서 갈라진다(Python transform은 external transforms로 source에 직접 연결할 수도 있으며 카드에 적는다) -->
        <!-- Virtual table은 Data Connection source 너머 외부 시스템의 테이블을 가리키는 포인터라서(복사가 아님) 점선으로 그린다.
             점선 화살표는 media ref처럼 가리키는 쪽에서 가리켜지는 쪽으로 향하므로 Virtual table에서 Data Connection 쪽을 향한다 -->
        <line class="ar dash" data-edges="dc:vt" x1="152" y1="34" x2="168" y2="34" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-edges="dc:transform" x1="256" y1="78" x2="212" y2="90" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-edges="dc:pb" x1="256" y1="78" x2="318" y2="90" marker-end="url(#fcm-ah)"></line>
        <text class="lab ae" data-edges="dc:transform dc:pb" x="206" y="86">가져온 Dataset을 입력으로</text>
        <!-- batch sync 선은 사선이 갈라지는 곳(y=78)에서 나눈다. 위쪽 구간은 transform·Pipeline Builder로 가는 길이기도 하다 -->
        <line class="ar" data-edges="dc:dataset dc:transform dc:pb" x1="256" y1="54" x2="256" y2="78"></line>
        <line class="ar" data-edges="dc:dataset" x1="256" y1="78" x2="256" y2="188" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-edges="dc:stream" x1="292" y1="54" x2="292" y2="188" marker-end="url(#fcm-ah)"></line>
        <text class="lab ae" data-edges="dc:dataset" x="250" y="68">batch sync</text>
        <text class="lab as" data-edges="dc:stream" x="298" y="68">streaming sync</text>
        <line class="ar" data-edges="transform:dataset builds:transform builds:dataset" x1="124" y1="144" x2="124" y2="188" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-edges="pb:dataset builds:pb builds:dataset" x1="400" y1="144" x2="264" y2="188" marker-end="url(#fcm-ah)"></line>

        <!-- 데이터 → 온톨로지: Dataset은 바로 또는 Restricted view를 거쳐, Stream은 바로 Funnel의 입력이 된다 (Restricted view는 Stream에 만들 수 없음) -->
        <line class="ar" data-edges="dataset:rv" x1="208" y1="242" x2="208" y2="254" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-edges="rv:funnel" x1="208" y1="280" x2="208" y2="290" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-edges="dataset:funnel" x1="266" y1="242" x2="266" y2="290" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-edges="stream:funnel" x1="296" y1="242" x2="296" y2="290" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-edges="funnel:onto" x1="230" y1="316" x2="230" y2="334" marker-end="url(#fcm-ah)"></line>
        <!-- Materialization은 원본 Dataset으로 돌아가지 않는다. Ontology의 최신 상태(원본 + 편집)를 담는 선택 출력 Dataset이라서
             원본 Dataset 상자가 아니라 따로 그린 회색 테두리 상자를 가리킨다. 실제로 데이터를 쓰는 출력이므로 실선이다(점선은 복사 없이 가리키는 관계만). 개념이 아니라 Funnel 카드에 딸린 출력이므로 data-id는 funnel이다 -->
        <a class="node link l-onto" href="#concept-funnel" data-id="funnel" data-edges="onto:funnel" aria-label="Materialization: datasource의 데이터와 편집을 합친 별도 출력 Dataset">
          <rect class="hit" x="18" y="250" width="128" height="86"></rect>
          <rect class="out" x="18" y="254" width="126" height="22" rx="6"></rect>
          <text class="out-t" x="81" y="269">Materialized Dataset</text>
          <line class="ar" x1="60" y1="336" x2="60" y2="278" marker-end="url(#fcm-ah)"></line>
          <text class="lab as" x="66" y="322">Materialization</text>
        </a>
        <!-- media reference: Object의 property가 Media set의 파일을 가리킨다(파일은 Media set에 그대로 있고 property 값은 backing Dataset의 컬럼).
             그래서 화살표는 Ontology에서 Media set 쪽을 가리킨다 -->
        <a class="node link l-data" href="#concept-media" data-id="media" data-edges="onto:media" aria-label="media reference: Object가 Media set의 파일을 가리킴">
          <rect class="hit" x="412" y="246" width="60" height="88"></rect>
          <line class="ar dash" x1="420" y1="334" x2="420" y2="244" marker-end="url(#fcm-ah)"></line>
          <text class="lab as" x="426" y="266">media</text>
          <text class="lab as" x="426" y="279">ref</text>
        </a>

        <!-- 로직 ↔ 온톨로지: 화살표는 데이터가 이동하는 방향이다. 로직 층에서 Ontology에 쓰는 것은 Action이라 Action만 위로 향하고
             Function·Compute module·Automate·AIP Logic은 Ontology에서 읽으므로 아래로 향한다.
             예외(Automate의 Logic effect가 staged writes를 끈 Logic 함수의 편집을 Action 없이 적용)는 AIP Logic 카드에 적는다.
             Compute module은 서비스 유저 권한으로 읽으므로 라벨로 표시한다.
             맨 오른쪽(x=494)은 앱이 Ontology를 직접 조회하는 호출선이며 라벨을 그 선 왼쪽에 붙여 AIP Logic 호출선과 구별한다 -->
        <line class="ar" data-edges="action:onto" x1="64" y1="470" x2="64" y2="434" marker-end="url(#fcm-ah)"></line>
        <text class="lab as" data-edges="action:onto" x="70" y="455">쓰기(편집)</text>
        <line class="ar" data-edges="onto:function" x1="148" y1="434" x2="148" y2="470" marker-end="url(#fcm-ah)"></line>
        <text class="lab as" data-edges="onto:function" x="154" y="455">읽기</text>
        <line class="ar" data-edges="onto:cm" x1="244" y1="434" x2="244" y2="470" marker-end="url(#fcm-ah)"></line>
        <text class="lab as" data-edges="onto:cm" x="250" y="455">서비스 유저</text>
        <line class="ar" data-edges="onto:automate" x1="342" y1="434" x2="342" y2="470" marker-end="url(#fcm-ah)"></line>
        <text class="lab as" data-edges="onto:automate" x="348" y="455">감시</text>
        <line class="ar" data-edges="onto:aip" x1="434" y1="434" x2="434" y2="470" marker-end="url(#fcm-ah)"></line>
        <text class="lab as" data-edges="onto:aip" x="440" y="455">읽기</text>

        <!-- 앱 → 로직·Ontology: 세 앱이 하나의 가로선에 모이고, 그 선에서 로직 상자로는 호출, 오른쪽 통로로는 Ontology 직접 조회.
             (Automate는 조건으로 실행되므로 호출 대상 아님. Object Explorer도 Action을 일괄 실행할 수 있어 분석 앱도 로직에 연결) -->
        <line class="ar" data-edges="workshop:action osdk:action analytics:action" x1="64" y1="552" x2="64" y2="526" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-edges="workshop:function osdk:function analytics:function" x1="148" y1="552" x2="148" y2="526" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-edges="workshop:cm osdk:cm" x1="244" y1="552" x2="244" y2="526" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-edges="workshop:aip osdk:aip" x1="434" y1="552" x2="434" y2="526" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-edges="workshop:onto osdk:onto analytics:onto" x1="494" y1="552" x2="494" y2="434" marker-end="url(#fcm-ah)"></line>
        <text class="lab ae" data-edges="workshop:onto osdk:onto analytics:onto" x="489" y="546">직접 조회</text>
        {busSegments.map((s) => <line class="ar" data-edges={s.edges} x1={s.x1} y1={busY} x2={s.x2} y2={busY}></line>)}
        <line class="ar" data-edges="workshop:action workshop:function workshop:cm workshop:aip workshop:onto" x1="98" y1="574" x2="98" y2="554" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-edges="osdk:action osdk:function osdk:cm osdk:aip osdk:onto" x1="269" y1="574" x2="269" y2="554" marker-end="url(#fcm-ah)"></line>
        <line class="ar" data-edges="analytics:action analytics:function analytics:onto" x1="470" y1="574" x2="470" y2="554" marker-end="url(#fcm-ah)"></line>
        <text class="lab" data-edges="workshop:action workshop:function workshop:cm workshop:aip osdk:action osdk:function osdk:cm osdk:aip analytics:action analytics:function" x="183" y="564">앱이 로직을 호출</text>
        <line class="ar" data-edges="osdk:oauth" x1="269" y1="628" x2="269" y2="642"></line>
        <!-- OAuth 상자 아래 가운데(x=269)에 두 줄로 둔다. 양옆의 Object Views(x=164까지)와 Ontology MCP(x=366부터)에 닿지 않을 만큼 짧게 쓴다 -->
        <text class="lab" data-edges="osdk:oauth" x="269" y="683">토큰 = 사용자(또는 서비스 유저) 권한</text>
        <text class="lab" data-edges="osdk:oauth" x="269" y="696">∩ 앱 제한 (scope는 작업 범위만 좁힘)</text>

        <!-- 운영: 두 줄. Approvals · Checkpoints는 권한 층의 개념이지만 Ontology proposal task로 Global Branching과 이어지므로 그 아래에 둔다 -->
        <text class="lab as" x="24" y="719">Ontology 정의, 여러 층의 변경·배포 관리 (지원 범위 안), 의존 관계 확인과 승인</text>
        <!-- 개념 상자: 위치·크기·부제는 mapNodes, 이름은 concepts.ts의 short(또는 mapLines)에서 가져온다 -->
        {mapNodes.map((n) => {
          const c = byId[n.id];
          const lines = c.mapLines ?? [c.short];
          const cx = n.x + n.w / 2;
          // 글자 기준선은 상자 높이에 맞춘다: 제목+부제는 가운데 위아래로, 제목만 있으면 가운데
          const mid = n.y + n.h / 2;
          const titleTop = n.id === "onto" ? n.y + 24 : n.sub ? mid - 3 : lines.length > 1 ? mid - 5 : mid + 4;
          const subY = n.id === "onto" ? n.y + 42 : mid + 13;
          return (
            <a class={`node l-${c.layer}`} href={`#concept-${n.id}`} data-id={n.id} data-edges={n.edges} aria-label={c.title}>
              <rect class="box" x={n.x} y={n.y} width={n.w} height={n.h} rx={n.rx ?? 8}></rect>
              {lines.map((line, i) => <text class={n.cls ?? "t"} x={cx} y={titleTop + i * 18}>{line}</text>)}
              {n.sub && <text class="s" x={cx} y={subY}>{n.sub}</text>}
            </a>
          );
        })}
        <!-- 노선 번호: 관점을 고르면 그 노선의 개념에만 순서 번호를 띄운다. 상자 위에 그리도록 상자 뒤에 둔다 -->
        <g class="badges" aria-hidden="true">
          {badges.map((b) => (
            <g class="badge" data-badge={b.id} transform={`translate(${b.x} ${b.y})`}>
              <circle r="8"></circle>
              <text y="3.5"></text>
            </g>
          ))}
        </g>
      </svg>
      </div>
      <figcaption>
        <ul class="map-legend">
          <li><svg viewBox="0 0 30 10" aria-hidden="true"><line class="lg-line" x1="1" y1="5" x2="23" y2="5"></line><path class="lg-head" d="M22,1 L29,5 L22,9 z"></path></svg><span>실선: 데이터가 이동하는 방향<br />로직 층에서 Ontology에 쓰는 선은 Action뿐이고 나머지는 Ontology를 읽음 (Automate의 Logic effect 예외는 AIP Logic 카드 참고)<br />앱에서 위로 올라가는 짧은 선과 앱 위의 가로선, 거기서 위로 나가는 선만 앱이 로직을 호출하거나 Ontology를 직접 조회하는 방향</span></li>
          <li><svg viewBox="0 0 30 10" aria-hidden="true"><line class="lg-line lg-dash" x1="1" y1="5" x2="23" y2="5"></line><path class="lg-head" d="M22,1 L29,5 L22,9 z"></path></svg>점선: 데이터를 복사하지 않고 가리키기만 하는 관계 (media ref는 Object가 Media set의 파일을 가리킴, Virtual table은 외부 시스템의 테이블을 가리킴)</li>
          <li><svg viewBox="0 0 30 10" aria-hidden="true"><rect class="lg-out" x="1" y="1" width="28" height="8" rx="3"></rect></svg>"Materialized Dataset" 상자: 개념이 아니라 Materialization이 만드는 선택 출력 Dataset (backing Dataset으로 돌아가지 않음)</li>
          <li><svg viewBox="0 0 30 10" aria-hidden="true"><path class="lg-line" d="M1,9 H29 M8,9 V2 M22,9 V2" fill="none"></path></svg>공용선(앱과 로직 사이의 가로선): 앱마다 실제로 호출하는 대상은 다르며 개념을 누르면 실제 연결만 강조됩니다</li>
          <li><svg viewBox="0 0 30 10" aria-hidden="true"><rect class="lg-extra" x="1" y="1" width="28" height="8" rx="3"></rect></svg>회색 점선 테두리 상자: 개념을 골랐을 때 그림에 선은 없지만 함께 동작하는 개념 (예: Automate가 실행하는 Action)</li>
          <li><svg viewBox="0 0 30 10" aria-hidden="true"><rect class="lg-frame" x="1" y="1" width="28" height="8" rx="3"></rect></svg>호박색 점선 테두리와 아래쪽 이름표: Project에 저장한 리소스에는 층과 관계없이 Project · Role · Marking 권한이 적용됨 (자세한 내용은 Project · Role · Marking 카드)</li>
        </ul>
        <p class="map-hint">개념을 고르면 그 개념과 연결된 상자와 화살표만 진하게 표시됩니다.</p>
      </figcaption>
    </figure>

    <!-- 고른 노선의 단계 설명. 읽어 주기는 화면에 영역이 없는 요소(display: contents 포함)와 button을 건너뛰므로
         감싸는 요소 없이 .explore에 바로 두고, 단계 이름은 본문의 개념 링크처럼 #concept-… 링크로 둔다.
         이름과 설명 사이의 <br>은 화면에서는 숨기고 읽어 주기에서 둘을 따로 읽게 하는 경계로만 쓴다 -->
    {routes.map((r) => (
      <div
        class="route"
        data-route-panel={r.id}
        data-steps={r.steps.flatMap((s, i) => s.ids.map((id) => `${id}:${i + 1}`)).join(" ")}
        data-route-edges={r.edges.map(([a, b]) => `${a}:${b}`).join(" ")}
        hidden
      >
        <ol class="route-steps" aria-label={r.question}>
          {r.steps.map((s, i) => (
            <li>
              <span class="step-no" aria-hidden="true">{i + 1}</span>
              <span class="step-body">
                <span class="step-names">
                  {s.ids.map((id, j) => (
                    <>{j > 0 && <span class="step-or">/</span>}<a class={`step-name l-${byId[id].layer}`} href={`#concept-${id}`}><i></i>{byId[id].short}</a></>
                  ))}
                </span>
                <br class="step-break" />
                <span class="step-note">{sentences(s.note).map((t, k) => <>{k > 0 && <br />}{t}</>)}</span>
              </span>
            </li>
          ))}
        </ol>
        {routeArticles[r.id] && (
          <p class="route-more">이 노선을 자세히 다룬 글: <a href={routeArticles[r.id]!.href}>{routeArticles[r.id]!.title}</a></p>
        )}
        <div class="route-src">
          <p class="route-src-label">근거 문서</p>
          <ul>{r.sources.map((s) => <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></li>)}</ul>
        </div>
      </div>
    ))}

    <section class="panel" aria-label="개념 카드">
      <div class="index" hidden>
      <div class="chips" aria-label="개념 목록">
        {groups.map((g) => (
          <div class={`chip-group l-${g.layer}`} role="group" aria-label={g.label}>
            <span class="glabel">{g.label}</span>
            <span class="gitems">
              {g.items.map((c) => (
                <button type="button" class={`chip l-${c.layer}`} data-chip={c.id} aria-label={c.title} aria-pressed="false">
                  <i></i>{c.short}
                </button>
              ))}
            </span>
          </div>
        ))}
      </div>
      <button type="button" class="index-toggle" aria-expanded="false">전체 목록 ▾</button>
      </div>

      <div class="cards" aria-live="polite">
        {concepts.map((c) => (
          <article class={`card l-${c.layer}`} id={`concept-${c.id}`} data-card={c.id}>
            <div class="cmeta">
              <span class="num">{layerLabels[c.layer]}</span>
            </div>
            <h3 class="ct">{c.title.replaceAll(" · ", "\u00a0· ")}</h3>
            <p class="lead">{sentences(c.lead).map((s, i) => <>{i > 0 && <br />}{s}</>)}</p>
            <div class="cbody detail">
            <div class="ana">
              <div class="ana-head">
                <b>비유로 보면</b>
                <span class="ana-tabs" role="group" aria-label="비유 관점" hidden>
                  <button type="button" data-view="dev" aria-pressed="true">개발자</button>
                  <button type="button" data-view="everyday" aria-pressed="false">일반</button>
                </span>
              </div>
              <p class="ana-dev"><span class="ana-kind">개발자: </span>{sentences(c.analogy).map((s, i) => <>{i > 0 && <br />}{s}</>)}</p>
              <p class="ana-everyday"><span class="ana-kind">일반: </span>{sentences(c.everyday).map((s, i) => <>{i > 0 && <br />}{s}</>)}</p>
            </div>
            <ul class="pts">
              {c.points.map((p) => <li><span>{sentences(p).map((s, i) => <>{i > 0 && <br />}{s}</>)}</span></li>)}
            </ul>
            {c.warn && <p class="warn"><b>주의</b><span>{sentences(c.warn).map((s, i) => <>{i > 0 && <br />}{s}</>)}</span></p>}
            </div>
            <div class="docs detail">
              {typeof c.doc === "string"
                ? <a class="doc" href={c.doc} target="_blank" rel="noopener noreferrer">공식 문서 ↗</a>
                : c.doc.map((d) => <a class="doc" href={d.href} target="_blank" rel="noopener noreferrer">{d.label} 문서 ↗</a>)}
              {c.related.length > 0 && (
                <p class="rels"><span class="rels-label">관련 문서</span>{c.related.map((r) => <a class="rel" href={r.href} target="_blank" rel="noopener noreferrer">{r.label} ↗</a>)}</p>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="nav" hidden>
        <!-- 지도는 카드보다 위(좁은 화면의 상단 막대)에도 옆(넓은 화면)에도 있으므로 방향 화살표를 붙이지 않는다 -->
        <a class="back" href="#concept-map">지도에서 보기</a>
        <button type="button" class="more" aria-expanded="false">자세히 ▾</button>
        <button type="button" class="fold" aria-expanded="false">펼치기 ▾</button>
        <button type="button" class="step" data-step="-1">이전</button>
        <button type="button" class="step" data-step="1">다음</button>
      </div>
    </section>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-fcm]");
  const panel = root?.querySelector<HTMLElement>(".panel");
  if (root && panel) {
    const cards = Array.from(panel.querySelectorAll<HTMLElement>("[data-card]"));
    const ids = cards.map((card) => card.dataset.card ?? "");
    const chips = panel.querySelector<HTMLElement>(".chips");
    const more = panel.querySelector<HTMLButtonElement>(".more");
    const indexToggle = panel.querySelector<HTMLButtonElement>(".index-toggle");
    const fold = panel.querySelector<HTMLButtonElement>(".fold");
    let current = 0;

    // 카드 패널을 글 페이지의 고정 자리로 옮긴다. 자리가 없으면 그림 옆(제자리)에서 동작
    const aside = document.getElementById("post-aside");
    if (aside) {
      aside.append(panel);
      aside.hidden = false;
      panel.dataset.docked = "";
      // 좁은 화면에서는 패널이 위에 붙는 막대가 되므로 글 첫머리가 아니라 지도 바로 위에서 시작하게 옮긴다.
      // 개념 링크는 모두 지도 아래 본문에 있다. 넓은 화면에서는 원래 자리(본문 옆 열)로 돌려놓는다
      const home = aside.parentElement;
      const homeNext = aside.nextElementSibling;
      const narrow = window.matchMedia("(max-width: 1179px)");
      const place = () => {
        if (narrow.matches) root.before(aside);
        else if (home && aside.parentElement !== home) home.insertBefore(aside, homeNext);
      };
      place();
      // 목록 모양이 바뀌므로(넓은 화면의 층별 줄 ↔ 좁은 화면의 가로 스크롤 줄) 현재 항목이 보이게 다시 맞춘다
      narrow.addEventListener("change", () => { place(); syncBar(); showCurrentChip(); });
    }
    // 카드 id는 JS가 없을 때의 앵커용. 켜진 뒤에는 지워서 #concept-… 해시로 브라우저가 스크롤하지 않게 한다
    cards.forEach((card) => card.removeAttribute("id"));
    const scroller = aside ?? panel;
    // 지도 위에 붙은 막대의 높이를 지도와 그 뒤 본문에 알려 둔다. 키보드로 상자나 링크에 포커스가 가면 이 높이만큼 비워 막대 아래에 보이게 한다(넓은 화면은 0).
    // 막대 높이를 바꾸는 곳(접기·자세히·카드 전환·비유 탭 전환·화면 폭 변화)에서 부른다
    const barHost = root.closest<HTMLElement>(".post-body") ?? root;
    const syncBar = () => barHost.style.setProperty("--fcm-bar", `${aside && aside.nextElementSibling === root ? aside.offsetHeight : 0}px`);
    window.addEventListener("resize", syncBar);
    // 좁은 화면에서 막대가 위에 붙어 있는지 표시한다. 붙어 있을 때만 본문 위 층에 그린다(CSS의 [data-stuck])
    const updateStuck = () => aside?.toggleAttribute("data-stuck", aside.nextElementSibling === root && aside.getBoundingClientRect().top <= 0.5);
    if (aside) {
      window.addEventListener("scroll", updateStuck, { passive: true });
      window.addEventListener("resize", updateStuck);
      updateStuck();
    }
    // 그림 상자는 SVG <a href="#concept-…">라서 원래부터 Tab으로 이동하고 Enter로 누를 수 있다.
    // 스크립트가 없으면 카드 앵커로 이동하고, 켜진 뒤에는 아래 클릭 처리에서 이동 없이 카드만 바꾼다
    root.dataset.enhanced = "";
    panel.dataset.enhanced = "";
    panel.querySelectorAll<HTMLElement>(".index, .nav").forEach((el) => (el.hidden = false));

    // 비유 관점(개발자/일반). 한 카드에서 고르면 모든 카드에 적용하고, 이 브라우저에 기억한다
    const VIEW_KEY = "fcm-analogy-view";
    function setView(view: string) {
      if (view !== "dev" && view !== "everyday") return;
      panel!.dataset.view = view;
      panel!.querySelectorAll<HTMLElement>("button[data-view]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.view === view)));
      try { localStorage.setItem(VIEW_KEY, view); } catch {}
      updateFade();
      // 펼친 막대에서는 비유 길이에 따라 막대 높이가 바뀐다
      syncBar();
    }
    panel.querySelectorAll<HTMLElement>(".ana-tabs").forEach((el) => (el.hidden = false));
    let savedView = "dev";
    try { savedView = localStorage.getItem(VIEW_KEY) ?? "dev"; } catch {}
    setView(savedView);

    // 목록을 펼치면 카드가, 접으면 본문이 스크롤되므로 여닫을 때 읽던 본문 위치를 반대쪽으로 넘긴다
    function setIndexOpen(open: boolean) {
      const card = cards[current];
      const body = card?.querySelector<HTMLElement>(".cbody");
      const bodyOffset = () => body!.getBoundingClientRect().top - card!.getBoundingClientRect().top + card!.scrollTop;
      const pos = body ? (panel!.classList.contains("index-open") ? card!.scrollTop - bodyOffset() : body.scrollTop) : 0;
      panel!.classList.toggle("index-open", open);
      if (body) {
        if (open) card!.scrollTop = pos > 0 ? pos + bodyOffset() : 0;
        else { card!.scrollTop = 0; body.scrollTop = Math.max(0, pos); }
      }
      if (indexToggle) {
        indexToggle.setAttribute("aria-expanded", String(open));
        indexToggle.textContent = open ? "접기 ▴" : "전체 목록 ▾";
      }
      if (open) showCurrentChip();
      updateFade();
    }

    // 카드 본문이 넘치면 아래쪽을 흐리게 해서 더 있다는 것을 보여준다
    function updateFade() {
      const body = cards[current]?.querySelector<HTMLElement>(".cbody");
      if (body) body.classList.toggle("has-more", body.scrollHeight - body.scrollTop - body.clientHeight > 4);
    }
    cards.forEach((card) => card.querySelector(".cbody")?.addEventListener("scroll", updateFade, { passive: true }));
    window.addEventListener("resize", updateFade);

    // 좁은 화면에서 위에 붙는 패널은 평소 한 줄(현재 개념 이름)로 접어 본문을 가리지 않게 한다.
    // 지도 상자·개념 목록·본문의 개념 링크로 개념을 고르거나 접힌 막대를 누르면 펼친다. 넓은 화면에서는 이 상태를 쓰지 않는다
    function setCollapsed(collapsed: boolean) {
      panel!.classList.toggle("is-collapsed", collapsed);
      if (collapsed) setExpanded(false);
      // 접힌 동안에는 목록이 숨어 폭이 0이라 맞출 수 없었으므로, 펼쳐서 목록이 보인 다음에 현재 항목으로 옮긴다
      else showCurrentChip();
      if (fold) {
        fold.setAttribute("aria-expanded", String(!collapsed));
        fold.textContent = collapsed ? "펼치기 ▾" : "접기 ▴";
      }
      syncBar();
    }

    // 자세히는 카드 본문만 여닫는다. 막대 전체를 접는 버튼(접기 ▴)과 함께 보이므로 닫는 문구를 다르게 둔다
    function setExpanded(open: boolean) {
      panel!.classList.toggle("is-expanded", open);
      // 다시 열 때 브라우저가 예전 스크롤 위치를 되살리므로 카드 맨 위에서 시작한다
      if (open) panel!.scrollTop = 0;
      if (more) {
        more.setAttribute("aria-expanded", String(open));
        more.textContent = open ? "간단히 ▴" : "자세히 ▾";
      }
      syncBar();
    }

    // 가로로 스크롤되는 목록(좁은 화면의 전체 줄, 넓은 화면의 접힌 층 줄)에서 현재 항목을 가운데로.
    // 목록의 scrollLeft만 바꿔서 페이지는 세로로 움직이지 않는다
    function showCurrentChip() {
      const chip = panel!.querySelector<HTMLElement>(`[data-chip="${ids[current]}"]`);
      if (!chip) return;
      for (const row of [chips, chip.closest<HTMLElement>(".gitems")]) {
        if (!row || row.scrollWidth <= row.clientWidth) continue;
        const br = chip.getBoundingClientRect();
        const cr = row.getBoundingClientRect();
        row.scrollLeft += br.left - cr.left - (cr.width - br.width) / 2;
      }
      // 화면이 낮아 펼친 목록이 세로로 스크롤되면(넓은 화면) 현재 항목이 보이게 목록의 scrollTop만 맞춘다
      const list = panel!.querySelector<HTMLElement>(".index");
      if (list && panel!.classList.contains("index-open") && list.scrollHeight > list.clientHeight) {
        const br = chip.getBoundingClientRect();
        const lr = list.getBoundingClientRect();
        if (br.top < lr.top + 4) list.scrollTop -= lr.top + 4 - br.top;
        else if (br.bottom > lr.bottom - 4) list.scrollTop += br.bottom - (lr.bottom - 4);
      }
    }

    // 연결 강조: 선·라벨마다 data-edges에 "a:b" 연결 쌍을 적어 두고, 고른 개념이 들어간 쌍의 상대편만 강조한다.
    // 여러 앱이 한 선을 공유해도 쌍 단위로 판단하므로, Workshop을 골라도 OSDK까지 딸려 오지 않는다.
    // 모든 층에 걸친 개념(권한 테두리, 운영 도구)은 흐리게 하지 않는다
    const map = root.querySelector<SVGElement>(".map");
    const edgeEls = Array.from(root.querySelectorAll<SVGElement>(".map [data-edges]"));
    const nodeEls = Array.from(root.querySelectorAll<SVGElement>(".map .node"));
    // Global Branching은 지원하는 리소스가 정해져 있으므로 흐리게 하지 않는 대상에서 빼고 지원 대상만 EXTRA_EDGES로 표시한다.
    // Marketplace도 product에 넣을 수 없는 리소스(예: Data Connection source)가 있지만 대부분의 리소스를 지원하므로 흐리게 하지 않는다
    const CROSS_CUTTING = new Set(["project", "market", "lineage"]);
    // 그림에 선은 없지만 공식 문서로 확인된 관계. 각 쌍의 근거는 해당 카드의 doc/related에 있다
    const EXTRA_EDGES: [string, string][] = [
      // Automate의 effect
      ["automate", "action"],
      ["automate", "function"],
      ["automate", "aip"],
      // 로직끼리: Logic 편집은 Action으로 저장, Logic이 Function 호출, Function-backed action, TypeScript function이 Compute module 호출
      ["aip", "action"],
      ["aip", "function"],
      ["function", "action"],
      ["function", "cm"],
      // 데이터: media sync와 미디어 변환, Pipeline Builder의 Ontology 출력, Build가 실행하는 sync job
      ["dc", "media"],
      ["transform", "media"],
      ["pb", "media"],
      ["pb", "onto"],
      ["builds", "dc"],
      // 분석 앱의 Dataset 분석, Workshop에 넣는 OSDK 앱·Quiver 대시보드
      ["analytics", "dataset"],
      ["analytics", "workshop"],
      ["osdk", "workshop"],
      // Ontology Manager가 만드는 Object type·Action type·Interface
      ["oma", "onto"],
      ["oma", "action"],
      ["oma", "interfaces"],
      // Stream을 출력하는 Pipeline Builder·Compute module, Stream 기반 Object type의 행·열 통제
      ["pb", "stream"],
      ["cm", "stream"],
      ["stream", "osp"],
      // Restricted view: Object security policy와 비교되는 방식, 자동으로 생기는 Build Schedule, Owner Role과 Marking 검토
      ["rv", "osp"],
      ["rv", "builds"],
      ["rv", "project"],
      // Approvals · Checkpoints: Global Branching proposal과 함께 생기는 Ontology proposal(Ontology Manager에서 검토),
      // 그룹·Project·Marking 접근 요청, Submit action checkpoint, Contour·Quiver export와 Object Explorer 검색 checkpoint
      ["approvals", "branch"],
      ["approvals", "oma"],
      ["approvals", "project"],
      ["approvals", "action"],
      ["approvals", "analytics"],
      // Virtual table: transform·Pipeline Builder의 입출력, Ontology Manager의 datasource, Contour 분석
      ["vt", "transform"],
      ["vt", "pb"],
      ["vt", "oma"],
      ["vt", "analytics"],
      // Model: model function, batch deployment의 입출력 Dataset과 Build Schedule, 2026년 2월부터 새 model function은 Ontology에 묶임
      ["model", "function"],
      ["model", "dataset"],
      ["model", "builds"],
      ["model", "onto"],
      // Object Views: Object 데이터를 보여 주고 configured 화면은 Workshop으로 만든다
      ["objectviews", "onto"],
      ["objectviews", "workshop"],
      // Object Explorer에서 Object 하나를 고르면 그 Object View가 열린다(Object Explorer overview)
      ["objectviews", "analytics"],
      // Interface를 쓰는 곳(Interface overview의 지원 목록): Action, OSDK, Workshop, TypeScript v2 function
      ["interfaces", "action"],
      ["interfaces", "osdk"],
      ["interfaces", "workshop"],
      ["interfaces", "function"],
      // Automate는 Compute module의 함수를 실행한다(Automate permissions)
      ["automate", "cm"],
      // Virtual table을 datasource로 쓰는 Object는 update detection이 원본 변경을 감지하면 다시 인덱싱된다(Virtual tables)
      ["vt", "funnel"],
      // Pipeline Builder의 trained model node로 파이프라인 안에서 모델 추론을 한다(Pipeline Builder transforms)
      ["model", "pb"],
      // Ontology MCP: Developer Console 앱과 앱 제한, Object 읽기, Action·query function 도구, AIP Logic 함수
      ["omcp", "osdk"],
      ["omcp", "onto"],
      ["omcp", "action"],
      ["omcp", "function"],
      ["omcp", "aip"],
      // OAuth: Ontology MCP는 Developer Console 앱의 OAuth 설정으로 인증한다.
      // Compute module은 Application permissions 모드에서 third-party application의 서비스 유저 자격 증명(client ID·secret)으로 OSDK를 쓴다
      ["omcp", "oauth"],
      ["cm", "oauth"],
      // Automate의 Dataset 갱신 조건과 streaming dataset 감시
      ["automate", "dataset"],
      ["automate", "stream"],
      // Compute module pipeline mode의 입출력(Dataset·Stream·Media set, cm:stream은 위에 있음)
      ["cm", "dataset"],
      ["cm", "media"],
      // Global Branching 지원 대상(Integrations 표): Workshop, Developer Console·OSDK, AIP Logic, Automate, direct model deployment,
      // Function, Ontology, Action, Materialization, Object Views, Code Repositories, Pipeline Builder, Restricted view, Lineage
      ["branch", "workshop"],
      ["branch", "osdk"],
      ["branch", "aip"],
      ["branch", "automate"],
      ["branch", "model"],
      ["branch", "function"],
      ["branch", "onto"],
      ["branch", "action"],
      ["branch", "funnel"],
      ["branch", "objectviews"],
      ["branch", "transform"],
      ["branch", "pb"],
      ["branch", "rv"],
      ["branch", "lineage"],
      // Object security policy도 Global Branching과 연동된다(Managing object security)
      ["branch", "osp"],
      // Ontology는 Ontology Manager에서 브랜치를 만들어 수정하고 Interface type도 브랜치 보호 대상이다(Branching the ontology)
      ["branch", "oma"],
      ["branch", "interfaces"],
    ];
    const pairsOf = (el: SVGElement) =>
      (el.dataset.edges ?? "").split(" ").filter(Boolean).map((pair) => pair.split(":") as [string, string]);
    // 처음 열었을 때는 지도 전체를 보여 주고, 사용자가 개념을 고른 뒤부터 강조한다
    let focusEnabled = false;
    // 지금 카드를 독자가 직접 골랐는지(개념 클릭·#concept-… 주소). 관점이 바꾼 카드는 직접 고른 것으로 보지 않는다
    let cardPicked = false;
    // 관점(노선)을 고른 동안에는 개념별 연결 강조 대신 노선 강조를 보여 준다
    let activeRoute = "";
    function focusRelations(id: string) {
      if (!map) return;
      const focus = focusEnabled && !activeRoute && !CROSS_CUTTING.has(id);
      map.classList.toggle("focus", focus);
      const related = new Set([id]);
      const addPartner = ([a, b]: [string, string]) => {
        if (a === id) related.add(b);
        if (b === id) related.add(a);
      };
      edgeEls.forEach((el) => {
        const pairs = pairsOf(el);
        const on = focus && pairs.some(([a, b]) => a === id || b === id);
        el.classList.toggle("rel-on", on);
        if (on) pairs.forEach(addPartner);
      });
      // 선이 없는 관계는 따로 모아 점선 테두리로 구분한다 (선으로도 이어져 있으면 진한 강조가 우선)
      const extra = new Set<string>();
      EXTRA_EDGES.forEach(([a, b]) => {
        if (a === id) extra.add(b);
        if (b === id) extra.add(a);
      });
      nodeEls.forEach((node) => {
        const nid = node.dataset.id ?? "";
        // Materialization·media ref처럼 상자에 딸린 화살표는 data-id가 아니라 자기가 실은 쌍으로 판단한다.
        // data-id로 판단하면 Dataset을 고를 때 Funnel과 함께 Materialization까지 진해져 원본과 이어진 것처럼 보인다
        const link = node.classList.contains("link");
        const on = focus && (link ? pairsOf(node).some(([a, b]) => a === id || b === id) : related.has(nid));
        node.classList.toggle("rel-on", on);
        node.classList.toggle("rel-extra", focus && !on && !link && extra.has(nid));
      });
    }

    // 관점(노선) 보기: 노선 패널의 data-steps("개념:번호")와 data-route-edges("a:b")로 지도를 강조한다.
    // 상자는 단계에 든 개념만, 선은 노선의 연결 쌍을 하나라도 실은 선만 진하게 한다.
    // Materialization·media ref처럼 상자에 딸린 화살표는 실은 쌍이 모두 노선에 있을 때만 강조한다
    const routeBox = root.querySelector<HTMLElement>("[data-routes]");
    const routePanels = Array.from(root.querySelectorAll<HTMLElement>("[data-route-panel]"));
    const badgeEls = Array.from(root.querySelectorAll<SVGGElement>(".map [data-badge]"));
    const words = (value: string | undefined) => (value ?? "").split(" ").filter(Boolean);
    function setRoute(rid: string, moveCard = true) {
      const routePanel = routePanels.find((p) => p.dataset.routePanel === rid);
      activeRoute = routePanel ? rid : "";
      // 노선을 보는 동안에는 선 종류 범례 대신 노선 안내를 보여 준다
      root!.classList.toggle("route-mode", !!routePanel);
      routeBox?.querySelectorAll<HTMLElement>("button[data-route]").forEach((b) => b.setAttribute("aria-pressed", String((b.dataset.route ?? "") === activeRoute)));
      routeBox?.querySelectorAll<HTMLElement>("[data-route-q]").forEach((q) => (q.hidden = q.dataset.routeQ !== activeRoute));
      routePanels.forEach((p) => (p.hidden = p !== routePanel));
      const steps = new Map(words(routePanel?.dataset.steps).map((s) => s.split(":") as [string, string]));
      // 관점을 고르면 첫 단계 카드로 바꾼다(#route-… 주소로 열 때와 같게). 독자가 직접 고른 카드가 노선의 단계이면 그대로 둔다.
      // 처음 열 때는 #concept-… 주소로 고른 카드를 지켜야 하므로 바꾸지 않는다
      if (moveCard && routePanel && (!cardPicked || !steps.has(ids[current]))) {
        const first = words(routePanel.dataset.steps)[0]?.split(":")[0] ?? "";
        if (ids.includes(first)) {
          render(ids.indexOf(first));
          cardPicked = false;
        }
      }
      const edges = new Set(words(routePanel?.dataset.routeEdges));
      // 방향까지 비교한다: Funnel → Ontology(인덱싱)와 Ontology → Funnel 출력(Materialization)은 다른 선이다
      const inRoute = ([a, b]: [string, string]) => edges.has(`${a}:${b}`);
      map?.classList.toggle("route", !!routePanel);
      nodeEls.forEach((node) => {
        const on = node.classList.contains("link") ? pairsOf(node).every(inRoute) : steps.has(node.dataset.id ?? "");
        node.classList.toggle("route-on", on);
      });
      edgeEls.forEach((el) => {
        if (!el.classList.contains("node")) el.classList.toggle("route-on", pairsOf(el).some(inRoute));
      });
      badgeEls.forEach((badge) => {
        const n = steps.get(badge.dataset.badge ?? "");
        badge.classList.toggle("on", !!n);
        const label = badge.querySelector("text");
        if (label) label.textContent = n ?? "";
      });
      focusRelations(ids[current]);
    }
    if (routeBox) routeBox.hidden = false;

    function render(index: number) {
      current = index;
      const id = ids[index];
      cards.forEach((card, i) => card.classList.toggle("is-active", i === index));
      root!.querySelectorAll(".map [data-id]").forEach((node) => node.classList.toggle("sel", node.getAttribute("data-id") === id));
      root!.querySelectorAll<HTMLElement>(".step-name").forEach((name) => name.classList.toggle("is-current", name.getAttribute("href") === `#concept-${id}`));
      focusRelations(id);
      panel!.querySelectorAll<HTMLElement>(".chip-group").forEach((group) => {
        group.classList.toggle("is-current", !!group.querySelector(`[data-chip="${id}"]`));
      });
      panel!.querySelectorAll<HTMLElement>("[data-chip]").forEach((chip) => chip.setAttribute("aria-pressed", String(chip.dataset.chip === id)));
      showCurrentChip();
      const body = cards[index].querySelector<HTMLElement>(".cbody");
      if (body) body.scrollTop = 0;
      cards[index].scrollTop = 0;
      panel!.scrollTop = 0;
      scroller.scrollTop = 0;
      updateFade();
      syncBar();
    }

    // 스크롤 위치는 건드리지 않고 카드만 바꾼다 (패널은 항상 화면에 고정되어 있음)
    function pick(id: string | null | undefined) {
      const index = id ? ids.indexOf(id) : -1;
      if (index < 0) return;
      focusEnabled = true;
      cardPicked = true;
      setCollapsed(false);
      render(index);
      history.replaceState(null, "", `#concept-${id}`);
    }

    // 좁은 화면에서 막대가 위에 붙어 있을 때 막대가 커지며 화면 좌표 top~bottom을 덮었거나 그 아래가 화면 밖으로 밀렸으면 세로로만 맞춘다
    const keepBelowBar = (top: number, bottom = top) => {
      if (!aside || aside.nextElementSibling !== root) return;
      const barBottom = aside.getBoundingClientRect().bottom + 8;
      if (top < barBottom) window.scrollBy(0, top - barBottom);
      else if (bottom > window.innerHeight) window.scrollBy(0, Math.min(bottom - window.innerHeight, top - barBottom));
    };

    // 그림이 옆으로 밀려 있으면 브라우저는 조금만 보이는 상자에도 그대로 포커스를 둔다.
    // 키보드로 상자에 가면 상자 전체가 보이게 그림을 가로로만 맞춘다(마우스로 누를 때는 그림을 움직이지 않는다)
    const mapScroll = root.querySelector<HTMLElement>(".map-scroll");
    mapScroll?.addEventListener("focusin", (event) => {
      const node = (event.target as Element).closest(".node:not(.frame-node)");
      if (!node || !node.matches(":focus-visible")) return;
      const r = node.getBoundingClientRect();
      const box = mapScroll.getBoundingClientRect();
      // 칸보다 넓은 상자(좁은 화면의 Ontology)는 가운데에 맞춰 이름과 부제가 보이게 한다
      if (r.width > box.width - 8) { mapScroll.scrollLeft += r.left + r.width / 2 - (box.left + box.width / 2); return; }
      if (r.left < box.left + 4) mapScroll.scrollLeft -= box.left + 4 - r.left;
      else if (r.right > box.right - 4) mapScroll.scrollLeft += r.right - (box.right - 4);
    });

    // 좁은 화면의 칩 줄도 가로로 스크롤되므로 키보드로 간 칩이 다 보이게 줄을 가로로만 맞춘다
    chips?.addEventListener("focusin", (event) => {
      const chip = (event.target as Element).closest<HTMLElement>("[data-chip]");
      if (!chip || !chip.matches(":focus-visible") || chips.scrollWidth <= chips.clientWidth) return;
      const r = chip.getBoundingClientRect();
      const box = chips.getBoundingClientRect();
      if (r.left < box.left + 4) chips.scrollLeft -= box.left + 4 - r.left;
      else if (r.right > box.right - 4) chips.scrollLeft += r.right - (box.right - 4);
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Element;
      // 이번 조작으로 막대가 위로 커졌는지 알기 위해 누르기 전 막대 위치를 잡아 둔다
      const barTopBefore = aside?.getBoundingClientRect().top ?? 0;
      // "지도에서 보기": 좁은 화면에서는 막대를 접고 그 높이만큼 비워 지도로 간다(기본 링크 이동은 막대 아래에 지도를 숨긴다)
      const back = target.closest(".back");
      if (back && panel.contains(back)) {
        event.preventDefault();
        const fig = root.querySelector<HTMLElement>(".fig") ?? root;
        // 좁은 화면에서는 그림 위의 "좌우로 밀어서" 안내까지 막대 아래에 보이게 한다
        const hint = root.querySelector<HTMLElement>(".map-scroll-hint");
        if (aside && aside.nextElementSibling === root) setCollapsed(true);
        scrollBelowBar(hint?.offsetHeight ? hint : fig);
        // 기본 링크 이동을 막았으므로 키보드 시작점도 지도로 옮긴다(다음 Tab이 지도의 첫 상자로 가게)
        fig.setAttribute("tabindex", "-1");
        fig.focus({ preventScroll: true });
        return;
      }
      // 좁은 화면에서 막대가 커진 뒤에도 카드 머리와 누른 버튼이 보이게 한다(보이면 그대로).
      // 본문 끝에서 밀려 올라간 막대는 위로 커져 머리가 화면 위로 숨으므로 막대 위 끝을 화면 안으로 내리고,
      // 위에 붙기 전인 막대는 아래로 커지며 마우스로 누르면 읽어 주기 도크 밑에 그려지므로 누른 버튼을 지금 보이는 도크(재생 중이면 조작 바) 위로 올린다
      const keepPressedInView = (button: HTMLElement) => {
        if (!aside || aside.nextElementSibling !== root) return;
        const barTop = aside.getBoundingClientRect().top;
        if (barTop < 0 && barTop < barTopBefore - 0.5) window.scrollBy(0, barTop);
        if (aside.getBoundingClientRect().top <= 0.5) return;
        const dock = Array.from(document.querySelectorAll<HTMLElement>(".ra-dock .ra-bar, .ra-dock .ra-start")).find((el) => el.getClientRects().length > 0);
        const limit = Math.min(window.innerHeight - 4, (dock?.getBoundingClientRect().top ?? window.innerHeight) - 8);
        const overlap = button.getBoundingClientRect().bottom - limit;
        if (overlap > 0) window.scrollBy(0, overlap);
      };
      if (more && target.closest(".more") === more) { setExpanded(!panel.classList.contains("is-expanded")); return keepPressedInView(more); }
      if (fold && target.closest(".fold") === fold) { setCollapsed(!panel.classList.contains("is-collapsed")); return keepPressedInView(fold); }
      // 접힌 카드를 탭해 열 때, 칩·비유 탭·이전/다음으로 카드가 바뀔 때도 막대 높이가 바뀌므로 같은 방식으로 보이게 한다
      if (panel.classList.contains("is-collapsed") && target.closest(".card.is-active") && panel.contains(target)) { setCollapsed(false); return keepPressedInView(fold ?? panel); }
      if (indexToggle && target.closest(".index-toggle") === indexToggle) return setIndexOpen(!panel.classList.contains("index-open"));
      const viewButton = target.closest<HTMLElement>("button[data-view]");
      if (viewButton && panel.contains(viewButton)) { setView(viewButton.dataset.view ?? ""); return keepPressedInView(viewButton); }
      const routeButton = target.closest<HTMLElement>("button[data-route]");
      if (routeButton && routeBox?.contains(routeButton)) {
        const rid = routeButton.dataset.route ?? "";
        // 좁은 화면에서 막대가 아직 위에 붙기 전이면 첫 단계 카드로 바뀌며 달라진 막대 높이만큼 따라 움직여 누른 버튼을 제자리에 둔다(지도 상자와 같게)
        const routeBarBefore = aside && aside.nextElementSibling === root && aside.getBoundingClientRect().top > 0.5 ? aside.offsetHeight : null;
        setRoute(rid);
        if (aside && routeBarBefore !== null) window.scrollBy(0, aside.offsetHeight - routeBarBefore);
        // 첫 단계 카드로 바뀌며 커진 막대가 누른 버튼과 질문을 덮지 않게 한다
        if (routeBox) keepBelowBar(routeBox.getBoundingClientRect().top);
        return history.replaceState(null, "", rid ? `#route-${rid}` : location.pathname + location.search);
      }
      const chip = target.closest<HTMLElement>("[data-chip]");
      if (chip) { pick(chip.dataset.chip); if (panel.contains(chip)) keepPressedInView(chip); return; }
      const step = target.closest<HTMLElement>("[data-step]");
      if (step && panel.contains(step)) {
        pick(ids[(current + Number(step.dataset.step) + ids.length) % ids.length]);
        return keepPressedInView(step);
      }
      const node = target.closest(".map [data-id]");
      if (node) {
        event.preventDefault();
        // 좁은 화면에서 막대가 아직 위에 붙기 전이면 막대가 펼쳐지는 만큼 지도가 밀리므로 그만큼 따라 내려 누른 상자를 제자리에 둔다
        const barBefore = aside && aside.nextElementSibling === root && aside.getBoundingClientRect().top > 0.5 ? aside.offsetHeight : null;
        pick(node.getAttribute("data-id"));
        if (aside && barBefore !== null) window.scrollBy(0, aside.offsetHeight - barBefore);
        // 막대가 위에 붙어 있으면 펼쳐진 막대에 가렸거나 화면 밖으로 밀린 경우에만 세로로 맞춘다(보이면 그대로, 그림의 가로 스크롤도 그대로).
        // 권한 테두리는 지도 전체 크기라서 이름표를 누르면 이름표를, 테두리 선을 누르면 누른 지점을 기준으로 한다
        const shown = node.classList.contains("frame-node") ? target.closest(".frame-node .box, .frame-node .tab") : node;
        if (shown) {
          const r = shown.getBoundingClientRect();
          keepBelowBar(r.top, r.bottom);
        } else if (event.detail) keepBelowBar((event as MouseEvent).clientY);
        return;
      }
      // 본문의 개념 링크(#concept-…)도 이동 없이 카드 전환으로 처리
      const link = target.closest<HTMLAnchorElement>('a[href^="#concept-"]');
      const linkId = link?.getAttribute("href")?.slice("#concept-".length);
      if (link && linkId && ids.includes(linkId)) {
        event.preventDefault();
        pick(linkId);
        // 펼쳐진 막대가 누른 노선 단계 이름이나 본문 링크를 덮으면 세로로만 맞춘다(지도 상자와 같게). 막대 안의 링크는 그대로 둔다
        if (!aside?.contains(link)) {
          const r = link.getBoundingClientRect();
          keepBelowBar(r.top, r.bottom);
        }
      }
    });


    // 개발 서버에서만: 지도 글자가 상자를 넘치거나 라벨이 상자·세로선과 겹치면 콘솔에 경고한다.
    // 새 개념을 넣거나 배치를 바꾼 뒤 `pnpm dev`로 글을 열어 [concept-map] 경고가 없는지 확인한다.
    if (import.meta.env.DEV && map) {
      const warnings: string[] = [];
      const boxes = Array.from(map.querySelectorAll<SVGGraphicsElement>(".node .box")).map((box) => ({
        id: box.closest<SVGElement>(".node")?.dataset.id,
        r: box.getBBox(),
      }));
      const hit = (a: DOMRect, b: DOMRect) => a.x < b.x + b.width && a.x + a.width > b.x && a.y < b.y + b.height && a.y + a.height > b.y;
      map.querySelectorAll<SVGGraphicsElement>(".node").forEach((node) => {
        const box = node.querySelector<SVGGraphicsElement>(".box")?.getBBox();
        if (!box) return;
        // 상자 테두리와 글자 사이에 최소 4px 여백이 있어야 한다 (가로·세로 모두)
        const PAD = 4;
        node.querySelectorAll<SVGTextElement>("text").forEach((text) => {
          const r = text.getBBox();
          const gaps = { 왼쪽: r.x - box.x, 오른쪽: box.x + box.width - (r.x + r.width), 위: r.y - box.y, 아래: box.y + box.height - (r.y + r.height) };
          const tight = Object.entries(gaps).filter(([, gap]) => gap < PAD).map(([side, gap]) => `${side} ${gap.toFixed(1)}px`);
          if (tight.length) warnings.push(`상자 테두리에 붙거나 넘치는 글자: ${node.dataset.id} "${text.textContent}" (${tight.join(", ")})`);
        });
      });
      const verticals = Array.from(map.querySelectorAll("line.ar"))
        .map((l) => ["x1", "y1", "x2", "y2"].map((k) => Number(l.getAttribute(k))))
        .filter(([x1, , x2]) => x1 === x2);
      // 가로선: 앱과 로직 사이의 공용선, 층 구분 점선
      const horizontals = Array.from(map.querySelectorAll("line.ar, line.band-sep"))
        .map((l) => ["x1", "y1", "x2", "y2"].map((k) => Number(l.getAttribute(k))))
        .filter(([, y1, , y2]) => y1 === y2);
      map.querySelectorAll<SVGTextElement>("text.lab").forEach((text) => {
        if (text.closest(".node")) return;
        const r = text.getBBox();
        // 글꼴에 따라 글자 폭이 달라지므로 겹치지 않아도 4px 안으로 붙으면 경고한다
        const near = new DOMRect(r.x - 4, r.y, r.width + 8, r.height);
        boxes.forEach((b) => { if (hit(near, b.r)) warnings.push(`상자와 겹치거나 4px 안으로 붙은 라벨: "${text.textContent}" × ${b.id}`); });
        verticals.forEach(([x, y1, , y2]) => {
          if (x > r.x && x < r.x + r.width && Math.min(y1, y2) < r.y + r.height && Math.max(y1, y2) > r.y) warnings.push(`세로선과 겹치는 라벨: "${text.textContent}" (x=${x})`);
        });
        horizontals.forEach(([x1, y, x2]) => {
          if (y > r.y && y < r.y + r.height && Math.min(x1, x2) < r.x + r.width && Math.max(x1, x2) > r.x) warnings.push(`가로선과 겹치는 라벨: "${text.textContent}" (y=${y})`);
        });
      });
      // 연결 쌍에 카드에 없는 개념 이름이 들어 있으면 오타일 가능성이 높다
      edgeEls.forEach((el) => pairsOf(el).flat().forEach((pid) => {
        if (!ids.includes(pid)) warnings.push(`연결 쌍에 없는 개념: "${pid}" (${el.getAttribute("data-edges")})`);
      }));
      // 선 없는 관계(EXTRA_EDGES)의 id 오타는 강조만 조용히 빠지므로 함께 검사한다
      EXTRA_EDGES.flat().forEach((pid) => {
        if (!ids.includes(pid)) warnings.push(`EXTRA_EDGES에 없는 개념: "${pid}"`);
      });
      // 노선의 선은 그림에 그려진 선의 data-edges와 방향까지 같아야 강조된다 (그림에 없는 관계는 노선 선으로 쓰지 않는다)
      routePanels.forEach((p) => words(p.dataset.routeEdges).forEach((pair) => {
        if (!edgeEls.some((el) => words(el.dataset.edges).includes(pair))) warnings.push(`노선 ${p.dataset.routePanel}의 선이 그림에 없거나 방향이 다름: ${pair}`);
      }));
      if (warnings.length) console.warn(`[concept-map] 배치 점검 ${warnings.length}건\n- ${warnings.join("\n- ")}`);
      else console.info("[concept-map] 배치 점검 통과");
    }

    // #route-… 주소는 그 관점을 켠 채로 연다 (연재 글에서 허브 지도의 노선으로 바로 보내는 용도)
    const routeFromHash = () => (location.hash.startsWith("#route-") ? location.hash.slice("#route-".length) : null);
    // 지도 쪽으로 스크롤한다. 좁은 화면에서는 지도 바로 위에 붙는 카드 막대 높이만큼 비워 둬서 막대가 지도를 가리지 않게 한다
    const scrollBelowBar = (el: Element) => {
      const bar = aside && aside.nextElementSibling === root ? aside.getBoundingClientRect().height : 0;
      window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - bar - 8 });
    };
    // 지도 첫머리(관점 선택)로 스크롤한다
    const showRoutes = () => scrollBelowBar(root);
    window.addEventListener("hashchange", () => {
      const rid = routeFromHash();
      if (rid === null) return pick(location.hash.replace("#concept-", ""));
      setRoute(rid);
      showRoutes();
    });

    const initial = location.hash.replace("#concept-", "");
    focusEnabled = ids.includes(initial);
    cardPicked = focusEnabled;
    setCollapsed(!focusEnabled);
    // 노선을 켠 채 열면(#route-… 또는 연재 글의 route) 카드는 그 노선의 첫 단계 개념으로 시작한다.
    // 연재 글이 route로 정한 노선은 주소에 #route-…가 없을 때만 켜고, 글 첫머리에서 시작하므로 스크롤하지 않는다
    const hashRoute = routeFromHash();
    const openRoute = hashRoute ?? root.dataset.initialRoute ?? "";
    const firstStep = words(routePanels.find((p) => p.dataset.routePanel === openRoute)?.dataset.steps)[0]?.split(":")[0] ?? "";
    render(ids.includes(initial) ? ids.indexOf(initial) : ids.includes(firstStep) ? ids.indexOf(firstStep) : ids.indexOf("onto"));
    if (openRoute) setRoute(openRoute, false);
    if (hashRoute) window.addEventListener("load", showRoutes, { once: true });
    // #concept-… 주소로 들어오면 브라우저가 이미 옛 카드 위치로 스크롤했으므로 지도 위치로 맞춘다
    if (ids.includes(initial)) {
      window.addEventListener("load", () => {
        scroller.scrollTop = 0;
        showRoutes();
      }, { once: true });
    }
  }
</script>

<style>
  /* 패널은 스크립트가 .fcm 밖(#post-aside)으로 옮기므로 색 변수를 패널에도 둔다 */
  .fcm, .panel {
    --fcm-mono: ui-monospace, SFMono-Regular, Menlo, monospace;
    --c-sec: #855510; --c-data: #0b6e6f; --c-onto: #4a4fc4; --c-logic: #b8324f; --c-app: #2c7a4e; --c-ops: #5f6b7d;
    --t-sec: #f8f0e4; --t-data: #e4f2f2; --t-onto: #ecedfa; --t-logic: #f8e7eb; --t-app: #e6f1ea; --t-ops: #edeff2;
    --s-sec: #eedcbf; --s-data: #c4e2e2; --s-onto: #d5d6f3; --s-logic: #efcbd3; --s-app: #c8e1d2; --s-ops: #d8dce2;
    font-size: 15px;
  }
  /* 다크 모드의 층 색: 선·글자(--c)는 밝게, 상자 바탕(--t)과 선택 바탕(--s)은 층 색이 살짝 도는 어두운 색 */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .fcm,
    :global(:root:not([data-theme="light"])) .panel {
      --c-sec: #e0a24a; --c-data: #3fbcbc; --c-onto: #9a9df2; --c-logic: #ef7b95; --c-app: #5fc68c; --c-ops: #9eaabb;
      --t-sec: #2a2216; --t-data: #13292a; --t-onto: #1e1f38; --t-logic: #2e171d; --t-app: #15291d; --t-ops: #20242b;
      --s-sec: #4a3a1f; --s-data: #1f4546; --s-onto: #32345e; --s-logic: #502632; --s-app: #234632; --s-ops: #343b46;
    }
  }
  :global(:root[data-theme="dark"]) .fcm,
  :global(:root[data-theme="dark"]) .panel {
    --c-sec: #e0a24a; --c-data: #3fbcbc; --c-onto: #9a9df2; --c-logic: #ef7b95; --c-app: #5fc68c; --c-ops: #9eaabb;
    --t-sec: #2a2216; --t-data: #13292a; --t-onto: #1e1f38; --t-logic: #2e171d; --t-app: #15291d; --t-ops: #20242b;
    --s-sec: #4a3a1f; --s-data: #1f4546; --s-onto: #32345e; --s-logic: #502632; --s-app: #234632; --s-ops: #343b46;
  }
  .fcm { margin: 24px 0 8px; }
  .l-sec { --c: var(--c-sec); --t: var(--t-sec); --s: var(--s-sec); }
  .l-data { --c: var(--c-data); --t: var(--t-data); --s: var(--s-data); }
  .l-onto { --c: var(--c-onto); --t: var(--t-onto); --s: var(--s-onto); }
  .l-logic { --c: var(--c-logic); --t: var(--t-logic); --s: var(--s-logic); }
  .l-app { --c: var(--c-app); --t: var(--t-app); --s: var(--s-app); }
  .l-ops { --c: var(--c-ops); --t: var(--t-ops); --s: var(--s-ops); }

  button { font: inherit; color: inherit; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .legend { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0; padding: 0; list-style: none; font-size: 13px; color: var(--muted); }
  .legend li { display: inline-flex; align-items: center; gap: 6px; }
  .legend i { width: 10px; height: 10px; border-radius: 3px; background: var(--t); border: 1.5px solid var(--c); }

  .explore { display: grid; gap: 20px; margin-top: 20px; }

  .fig { margin: 0; min-width: 0; }
  .map-scroll { overflow-x: auto; }
  .fig svg { display: block; width: 100%; max-width: 700px; height: auto; margin: 0 auto; }
  /* 좁은 화면에서는 글자가 읽히는 크기를 유지하고 그림을 좌우로 밀어 보게 한다.
     본문 폭(화면 폭 - 32px)이 그림 폭 560px보다 좁아지는 591px부터만 밀 것이 생기므로 안내도 그때만 보인다 */
  .map-scroll-hint { display: none; }
  @media (max-width: 591px) {
    .fig svg { width: 560px; max-width: none; }
    .map-scroll-hint { display: block; margin: 0 0 6px; font-size: 12px; color: var(--muted); }
  }
  /* 노선 모드의 그림(svg.map.route)은 노선 패널과 같은 .route 테두리·여백을 받으므로 border-box로 크기를 맞춰 칸을 넘치지 않게 한다(넓은 화면 734px, 591px 이하 594px = 내용 560px) */
  .fig svg.route { box-sizing: border-box; max-width: 734px; }
  @media (max-width: 591px) { .fig svg.route { width: 594px; } }
  .fig figcaption { font-size: 13px; color: var(--muted); margin-top: 12px; line-height: 1.5; }
  .map-legend { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; }
  .map-legend li { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 8px; align-items: center; }
  .map-legend svg { width: 30px; height: 10px; }
  .lg-line { stroke: var(--muted); stroke-width: 1.4; }
  .lg-dash { stroke-dasharray: 4 3; }
  .lg-head { fill: var(--muted); }
  .lg-frame { fill: none; stroke: var(--c-sec); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .lg-extra { fill: var(--surface); stroke: var(--muted); stroke-width: 1.4; stroke-dasharray: 3 2; }
  .lg-out { fill: var(--surface); stroke: var(--border); stroke-width: 1.4; }
  .map-hint { margin: 6px 0 0; }

  /* 관점(노선) 보기: 질문 하나를 고르면 그 노선의 단계와 근거 문서를 보여 준다 */
  .routes[hidden], .route[hidden], .route-q[hidden] { display: none; }
  .routes { display: grid; gap: 8px; margin-top: 14px; }
  /* 한국어 질문과 단계 설명은 낱말 단위로 줄을 바꾼다 */
  .route-q, .route-hint, .step-note { word-break: keep-all; }
  .route-mode .fig figcaption { display: none; }
  .route-tabs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .route-label { margin-right: 4px; font-size: 13px; font-weight: 700; color: var(--muted); }
  .route-tabs button { height: 30px; padding: 0 11px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); font-size: 13px; cursor: pointer; }
  .route-tabs button[aria-pressed="true"] { background: var(--text); border-color: var(--text); color: var(--bg); font-weight: 600; }
  .route { display: grid; gap: 10px; padding: 14px 16px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); }
  .route-q { margin: 4px 0 0; font-size: 16px; font-weight: 700; line-height: 1.45; }
  .route-steps { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .route-steps li { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 10px; align-items: start; }
  .step-no { width: 20px; height: 20px; margin-top: 1px; border-radius: 50%; background: var(--text); color: var(--bg); font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
  .step-body { display: grid; gap: 2px; min-width: 0; }
  .step-names { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 6px; }
  .step-or { color: var(--muted); }
  .step-name { display: inline-flex; align-items: center; gap: 5px; padding: 0 4px; margin: 0 -4px; border-radius: 5px; color: var(--text); font-size: 14px; font-weight: 700; text-decoration: underline; text-decoration-color: var(--border); text-underline-offset: 3px; }
  .step-break { display: none; }
  .step-name i { width: 7px; height: 7px; border-radius: 50%; background: var(--c); }
  .step-name:hover { text-decoration-color: currentColor; }
  .step-name.is-current { background: var(--s); text-decoration: none; }
  .step-note { font-size: 14px; line-height: 1.55; }
  .route-more { margin: 0; padding-top: 10px; border-top: 1px solid var(--border); font-size: 14px; font-weight: 600; word-break: keep-all; }
  /* 근거 문서는 목록으로 둬서 읽어 주기가 문서 이름을 하나씩 끊어 읽게 한다 */
  .route-src { display: flex; gap: 4px 12px; align-items: baseline; font-size: 12px; }
  .route-src-label { flex: none; margin: 0; color: var(--muted); }
  .route-src ul { display: flex; flex-wrap: wrap; gap: 4px 12px; margin: 0; padding: 0; list-style: none; }
  .route-hint { display: none; margin: 0; font-size: 12px; color: var(--muted); }
  .route-mode .route-hint { display: block; }

  .map text { fill: var(--text); font-family: inherit; text-anchor: middle; }
  .map .t { font-size: 12px; font-weight: 600; }
  .map .tb { font-size: 13px; font-weight: 700; }
  .map .sm { font-size: 11px; }
  .map .s, .map .lab { font-size: 11px; fill: var(--muted); }
  .map .as { text-anchor: start; }
  .map .ae { text-anchor: end; }
  .map .ar { stroke: var(--muted); stroke-width: 1.2; fill: none; }
  .map .dash { stroke-dasharray: 4 3; }
  .map .ahp { fill: var(--muted); }
  .map .src rect { fill: none; stroke: var(--muted); stroke-dasharray: 4 3; }
  .map .frame { fill: none; stroke: var(--c); stroke-width: 1.3; stroke-dasharray: 6 4; pointer-events: stroke; }
  .map .tab { font-size: 11px; font-weight: 700; fill: var(--c); }
  .node.sel .frame { stroke-width: 2.4; }
  /* 연결 강조: 개념을 고르면 연결되지 않은 상자·화살표를 흐리게 */
  .map [data-edges], .map .node { transition: opacity 0.15s; }
  /* 흐리게 한 상자라도 키보드 포커스를 받으면 포커스 표시가 보이도록 흐리게 하지 않는다 */
  .map.focus [data-edges]:not(.rel-on):not(.rel-extra):not(:focus-visible), .map.focus .node:not(.rel-on):not(.rel-extra):not(.frame-node):not(:focus-visible) { opacity: 0.25; }
  /* 선 없는 관계는 층 색 대신 회색 점선으로 그려 호박색 권한 테두리와 헷갈리지 않게 한다 */
  .node.rel-extra .box { stroke: var(--muted); stroke-dasharray: 4 3; stroke-width: 1.8; }
  .map.focus .ar.rel-on, .map.focus .rel-on .ar { stroke: var(--text); stroke-width: 1.6; }
  .map.focus .lab.rel-on, .map.focus .rel-on .lab { fill: var(--text); }
  /* 노선 강조: 노선에 없는 상자·선은 흐리게, 노선의 선과 라벨은 진하게, 단계 번호를 상자 모서리에 */
  .map.route .node:not(.route-on):not(:focus-visible), .map.route [data-edges]:not(.node):not(.route-on) { opacity: 0.2; }
  .map.route .node.route-on:not(.link):not(:focus-visible) .box { stroke-width: 2; }
  .map.route .ar.route-on, .map.route .node.link.route-on .ar { stroke: var(--text); stroke-width: 1.6; }
  .map.route .lab.route-on, .map.route .node.link.route-on .lab { fill: var(--text); }
  .map .badge { display: none; pointer-events: none; }
  .map.route .badge.on { display: inline; }
  .map .badge circle { fill: var(--text); stroke: var(--bg); stroke-width: 1.5; }
  .map .badge text { fill: var(--bg); font-size: 10px; font-weight: 700; }
  .map .hit { fill: transparent; }
  /* Materialization·media ref 화살표는 상자가 없으므로 포커스를 받으면 누르는 영역 둘레를 강조한다 */
  .node.link:focus-visible .hit { stroke: var(--accent); stroke-width: 2; }
  /* 좁은 화면에서 위에 붙은 막대(--fcm-bar) 아래로 포커스된 버튼·상자·링크가 숨지 않게 한다.
     막대는 본문 끝까지 붙어 있으므로 지도 뒤 본문의 링크·버튼에도 같은 여백을 준다(아래에 붙는 읽어 주기 막대는 제외) */
  .fcm :is(a[href], button) { scroll-margin-top: calc(var(--fcm-bar, 0px) + 8px); }
  /* 대상 종류는 ReadAloud.astro의 scroll-margin-bottom 선택자와 같게 둔다. 표처럼 .post-body의 직속 자식인 대상은 뒤 줄이 맞춘다 */
  :global(.post-body > [data-fcm] ~ :not(.ra-dock) :is(a[href], button, summary, input, select, textarea, iframe, video[controls], audio[controls], [contenteditable], [tabindex], table, pre)) { scroll-margin-top: calc(var(--fcm-bar, 0px) + 8px); }
  :global(.post-body > [data-fcm] ~ :is(a[href], button, summary, input, select, textarea, iframe, video[controls], audio[controls], [contenteditable], [tabindex], table, pre):not(.ra-dock)) { scroll-margin-top: calc(var(--fcm-bar, 0px) + 8px); }
  /* Materialization이 만드는 출력 Dataset: 개념 상자와 구별되게 옅은 테두리와 회색 글자 */
  .map .out { fill: var(--surface); stroke: var(--border); stroke-width: 1.2; }
  .map .out-t { font-size: 11px; fill: var(--muted); }
  .map .band-bar { fill: var(--c); opacity: 0.7; }
  .map .band-label { font-size: 12px; font-weight: 700; fill: var(--c); text-anchor: start; }
  .map .band-sep { stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 4; }
  [data-enhanced] .node { cursor: pointer; }
  .node:focus { outline: none; }
  .node .box { fill: var(--t); stroke: var(--c); stroke-width: 1.2; }
  [data-enhanced] .node:hover .box { stroke-width: 2; }
  .node.sel .box { fill: var(--s); stroke-width: 2.4; }
  /* 고른 상자의 바탕(--s)에서는 회색 부제가 WCAG AA에 못 미치므로 본문 글자색으로 바꾼다 */
  .node.sel .s { fill: var(--text); }
  /* 층 색과 accent의 명도가 거의 같아 테두리 색만 바꾸면 포커스가 보이지 않으므로 상자 바깥에 윤곽선을 두고 테두리는 글자색으로 바꾼다 */
  .node:focus-visible .box { stroke: var(--text); stroke-width: 2.6; }
  .map .node:not(.link):not(.frame-node):focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* 권한 테두리는 이름표가 지도 맨 아래에 있어 화면 밖일 수 있으므로 테두리 전체로 포커스를 보인다.
     고른 상태(2.4)와 색만 다르면 구별이 어려우므로 점선을 실선으로 바꾸고 더 굵게 한다 */
  .node.frame-node:focus-visible .frame { stroke: var(--accent); stroke-width: 3; stroke-dasharray: none; }
  .node.link:hover .lab, .node.link.sel .lab, .node.link:focus-visible .lab { fill: var(--c); font-weight: 600; }
  .node.link.sel .ar { stroke: var(--c); stroke-width: 1.8; }

  .panel { display: grid; gap: 12px; min-width: 0; }
  /* 안에서 스크롤되는 곳은 포커스된 요소를 가장자리에 딱 붙여 보여 주므로 포커스 윤곽선이 들어갈 4px를 남긴다 */
  [data-docked] .card, [data-docked] .cbody, [data-docked].is-expanded { scroll-padding-block: 4px; }
  .cards { display: grid; gap: 16px; }
  [data-enhanced] .card:not(.is-active) { display: none; }

  /* 개념 목록: 넓은 화면은 층별로 줄을 나누고, 좁은 화면(상단 고정)은 한 줄 가로 스크롤 */
  .chips { display: grid; gap: 6px; }
  .chip-group { display: grid; grid-template-columns: 4.6em minmax(0, 1fr); align-items: start; gap: 6px; }
  .gitems { display: flex; flex-wrap: wrap; gap: 4px 5px; }
  .glabel { padding-top: 5px; font-size: 11px; font-weight: 600; color: var(--c); }
  .index[hidden], .nav[hidden] { display: none; }
  .index { min-width: 0; }
  .index-toggle { display: none; }
  .cbody { display: grid; gap: 12px; }
  .chip { flex: 0 0 auto; height: 26px; padding: 0 8px; border-radius: 7px; border: 1px solid var(--border); background: var(--surface); font-size: 12px; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px; cursor: pointer; }
  .chip i { width: 6px; height: 6px; border-radius: 50%; background: var(--c); }
  .chip[aria-pressed="true"] { background: var(--s); border-color: var(--c); }

  /* 가운뎃점으로 이은 긴 낱말(Object·Action·Function·…)이 좁은 화면에서 카드 밖으로 나가지 않게 들어가지 않을 때만 끊는다 */
  .card { overflow-wrap: anywhere; }
  .card { scroll-margin-top: 16px; background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--c); border-radius: 12px; padding: 16px 18px 18px; display: grid; gap: 12px; min-width: 0; }
  .cmeta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font: 500 12px var(--fcm-mono); color: var(--muted); }
  .num { background: var(--c); color: var(--surface); border-radius: 6px; padding: 1px 8px; font-family: inherit; font-weight: 600; }
  .ct { font-size: 1.3rem; line-height: 1.3; margin: 0; text-wrap: balance; }
  .lead { font-size: 16px; font-weight: 500; margin: 0; line-height: 1.55; }
  .ana { background: var(--t); border-radius: 10px; padding: 12px 14px; }
  /* 카드 안 라벨(비유로 보면, 주의)은 본문과 같은 글꼴로, 한 줄을 따로 차지 */
  .ana b, .warn b { display: block; font-size: 12px; font-weight: 700; margin-bottom: 2px; }
  .ana b { color: var(--c); margin: 0; }
  .ana { display: grid; gap: 6px; }
  .ana-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .ana-tabs[hidden] { display: none; }
  /* overflow: hidden이면 키보드 포커스 윤곽선이 잘리므로 모서리는 양 끝 버튼에 둥글게 주고, 포커스된 칸은 옆 칸 바탕 위로 올린다 */
  .ana-tabs { display: inline-flex; border: 1px solid var(--c); border-radius: 7px; background: var(--surface); }
  .ana-tabs button:first-child { border-radius: 6px 0 0 6px; }
  .ana-tabs button:last-child { border-radius: 0 6px 6px 0; }
  .ana-tabs button:focus-visible { position: relative; z-index: 1; }
  .ana-tabs button { border: 0; background: none; padding: 2px 9px; font-size: 12px; cursor: pointer; color: var(--c); }
  .ana-tabs button[aria-pressed="true"] { background: var(--c); color: var(--surface); font-weight: 600; }
  .ana-kind { font-weight: 600; }
  /* 스크립트가 켜지면 고른 관점의 비유만 보여 준다 (없으면 둘 다 표시) */
  [data-view] .ana-kind { display: none; }
  [data-view="dev"] .ana-everyday, [data-view="everyday"] .ana-dev { display: none; }
  .ana p { margin: 0; }
  .pts { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .pts li { display: grid; grid-template-columns: 8px minmax(0, 1fr); gap: 10px; }
  .pts li::before { content: ""; width: 6px; height: 6px; background: var(--c); margin-top: 0.62em; border-radius: 1px; }
  .warn { border: 1px dashed var(--muted); border-radius: 10px; padding: 10px 12px; margin: 0; }
  .warn b { color: var(--muted); }
  .docs { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 13px; }
  /* 관련 문서는 공식 문서 버튼과 같은 단계로 보이지 않게 아래 줄로 내린다 */
  .rels { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: center; margin: 0; }
  .rels-label { color: var(--muted); font-size: 12px; }
  .doc { display: inline-flex; align-items: center; padding: 7px 12px; border-radius: 9px; background: var(--text); color: var(--surface); text-decoration: none; font-weight: 600; }

  .nav { display: flex; gap: 6px; justify-content: flex-end; }
  /* 지도 링크(a)도 버튼과 같은 높이가 되게 테두리를 높이 안에 넣는다 */
  .nav button, .back { box-sizing: border-box; height: 34px; padding: 0 12px; border-radius: 9px; border: 1px solid var(--border); background: var(--surface); cursor: pointer; font-size: 13px; display: inline-flex; align-items: center; text-decoration: none; color: var(--text); }
  .back { margin-right: auto; }
  .more { display: none !important; }
  /* 접기 버튼은 좁은 화면(상단 고정 패널)에서만 보인다. .nav button보다 우선하도록 .nav를 붙인다 */
  .nav .fold { display: none; }

  /* 넓은 화면의 사이드 패널: 화면 높이에 맞추고, 목록은 현재 층만 남기고 접으며, 카드는 가운데 본문만 스크롤 */
  @media (min-width: 1180px) {
    [data-docked] { display: flex; flex-direction: column; gap: 10px; max-height: calc(100vh - 32px); }
    [data-docked] .index { display: flex; align-items: flex-start; gap: 6px; }
    /* 전체 목록을 펼치면 31개 이름이 여러 줄이 되므로 칩 높이를 조금 줄여 패널이 화면 높이를 넘지 않게 한다 */
    [data-docked] .chip { height: auto; min-height: 24px; }
    /* 칸보다 긴 이름은 옆의 전체 목록 버튼을 덮지 않고 칩 안에서 줄을 바꾼다 */
    [data-docked] .chip { max-width: 100%; padding-block: 3px; white-space: normal; text-align: left; line-height: 1.3; }
    /* 층 이름 칸은 접었을 때와 펼쳤을 때 같은 폭으로 둬서 칩 위치가 바뀌지 않게 한다.
       가장 긴 층 이름(권한·보안, 약 42px)에 여유를 더한 폭이며 가장 긴 칩(Contour · Quiver · Object Explorer, 약 220px)이
       접힌 줄(전체 목록 버튼 옆)에 들어가도록 기본 4.6em보다 좁힌다 */
    [data-docked] .chip-group { grid-template-columns: 50px minmax(0, 1fr); }
    [data-docked] .chips { flex: 1; min-width: 0; }
    [data-docked] .index-toggle { display: inline-flex; flex: none; height: 26px; padding: 0 8px; border-radius: 7px; border: 1px solid var(--border); background: var(--surface); font-size: 12px; white-space: nowrap; align-items: center; cursor: pointer; }
    [data-docked]:not(.index-open) .chip-group:not(.is-current) { display: none; }
    /* 접힌 상태: 층 이름과 현재 개념만 한 줄로. 같은 층의 다른 개념은 이전/다음이나 전체 목록으로 이동 */
    [data-docked]:not(.index-open) .chip:not([aria-pressed="true"]) { display: none; }
    [data-docked] .cards { flex: 0 1 auto; min-height: 0; display: flex; flex-direction: column; }
    [data-docked] .card.is-active { display: flex; flex-direction: column; min-height: 0; }
    [data-docked] .cbody { flex: 0 1 auto; min-height: 96px; overflow-y: auto; overscroll-behavior: contain; }
    [data-docked] .cbody.has-more { mask-image: linear-gradient(to bottom, #000 calc(100% - 36px), transparent); }
    /* 전체 목록을 펼치면 본문이 최소 높이까지 줄어도 요약·링크가 길면 넘치므로 카드 전체를 스크롤.
       본문은 줄이지 않고 펼쳐 두어 스크롤 영역이 두 겹이 되지 않게 한다 */
    [data-docked].index-open .card.is-active { overflow-y: auto; overscroll-behavior: contain; }
    [data-docked].index-open .cbody { flex: none; min-height: 0; overflow: visible; }
    /* 화면이 낮으면 펼친 목록(약 600px)이 높이를 다 차지해 카드가 사라지므로, 카드 180px·버튼 줄·간격(234px)을 남기고 목록 안에서 스크롤한다.
       높이가 넉넉하면 목록은 다 보이고 지금처럼 카드만 스크롤된다. 스크롤되는 목록의 가장자리 칩도 포커스 윤곽선이 잘리지 않게 4px 여백을 둔다 */
    [data-docked].index-open .index-toggle { position: sticky; top: 0; }
    [data-docked].index-open .index { flex-shrink: 0; min-height: 0; max-height: calc(100vh - 32px - 234px); overflow-y: auto; overscroll-behavior: contain; padding: 4px; margin: -4px; scroll-padding-block: 4px; }
    [data-docked] .nav { flex: none; }
  }

  /* 좁은 화면에서 상단에 고정된 패널: 제목·요약만 보이고 '자세히'로 펼침 */
  @media (max-width: 1179px) {
    /* 막대(#post-aside)는 지도 바로 앞에 오며 margin-bottom 124px로 본문 끝의 읽어 주기 도크 앞에서 멈춘다. 겹쳐지는 여백이 원래의 24px가 되게 한다 */
    :global(#post-aside) + .fcm { margin-top: -100px; }
    /* 막대는 위에 붙어 있거나 키보드 포커스가 안에 있을 때만 본문 위에 그린다. 그 밖에는 다른 본문처럼 화면 아래의 읽어 주기 도크 밑으로 지나간다.
